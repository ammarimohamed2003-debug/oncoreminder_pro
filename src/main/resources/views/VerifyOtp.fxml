<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.geometry.Insets?>

<HBox styleClass="root-pane" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.oncoreminder.controllers.VerifyOtpController">

    <!-- ═══ PANNEAU GAUCHE — Branding ═══ -->
    <VBox styleClass="auth-left" prefWidth="480" minWidth="380" alignment="CENTER" spacing="28">
        <padding><Insets bottom="60" left="50" right="50" top="60"/></padding>

        <StackPane>
            <Circle radius="75" fill="rgba(255,255,255,0.04)"/>
            <Circle radius="58" fill="rgba(255,255,255,0.07)"/>
            <Circle radius="42" fill="rgba(43,188,176,0.25)"/>
            <Circle radius="28" fill="rgba(43,188,176,0.45)"/>
            <Label text="⚕" style="-fx-font-size: 30px; -fx-text-fill: white;"/>
        </StackPane>

        <VBox alignment="CENTER" spacing="4">
            <Label text="OncoReminder" styleClass="auth-title"/>
            <Label text="P  R  O" styleClass="auth-subtitle"/>
        </VBox>

        <HBox alignment="CENTER" spacing="10">
            <Line startX="0" endX="60" stroke="rgba(255,255,255,0.25)" strokeWidth="1"/>
            <Circle radius="4" fill="#2BBCB0"/>
            <Line startX="0" endX="60" stroke="rgba(255,255,255,0.25)" strokeWidth="1"/>
        </HBox>

        <VBox alignment="CENTER" spacing="12">
            <Label text="Vérification OTP"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2BBCB0;"/>
            <Label text="Un code à 6 chiffres a été envoyé&#10;à votre adresse email."
                   styleClass="auth-tagline" alignment="CENTER" wrapText="true"/>
        </VBox>

        <VBox spacing="14" alignment="CENTER_LEFT" maxWidth="280">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane>
                    <Circle radius="18" fill="rgba(43,188,176,0.20)"/>
                    <Label text="✓" style="-fx-font-size: 13px; -fx-text-fill: #2BBCB0; -fx-font-weight: bold;"/>
                </StackPane>
                <Label text="Email envoyé"
                       style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 13px;"/>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane>
                    <Circle radius="18" fill="rgba(43,188,176,0.35)"/>
                    <Label text="2" style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </StackPane>
                <Label text="Entrez le code OTP" styleClass="auth-feature-label"/>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane>
                    <Circle radius="18" fill="rgba(255,255,255,0.12)"/>
                    <Label text="3" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.4); -fx-font-weight: bold;"/>
                </StackPane>
                <Label text="Nouveau mot de passe"
                       style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 13px;"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
        <HBox spacing="8" alignment="CENTER">
            <Circle radius="5" fill="rgba(255,255,255,0.15)"/>
            <Circle radius="5" fill="#2BBCB0"/>
            <Circle radius="5" fill="rgba(255,255,255,0.15)"/>
        </HBox>
    </VBox>

    <!-- ═══ PANNEAU DROIT — Formulaire ═══ -->
    <VBox styleClass="auth-right" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="18">
        <padding><Insets bottom="60" left="80" right="80" top="60"/></padding>

        <StackPane>
            <Circle radius="32" fill="rgba(43,188,176,0.12)"/>
            <Circle radius="22" fill="rgba(43,188,176,0.20)"/>
            <Label text="📧" style="-fx-font-size: 22px;"/>
        </StackPane>

        <Label text="Code de vérification" styleClass="auth-right-title"/>
        <Label fx:id="subtitleLabel" text="Vérifiez votre boîte email" styleClass="auth-right-sub"/>

        <VBox spacing="16" maxWidth="380" fillWidth="true">

            <!-- Champ OTP -->
            <VBox spacing="6" alignment="CENTER">
                <Label text="Code OTP à 6 chiffres" styleClass="field-label"/>
                <TextField fx:id="otpField" promptText="000000"
                           styleClass="field-input"
                           prefHeight="56" maxWidth="220"
                           style="-fx-font-size: 26px; -fx-font-weight: bold;
                                  -fx-alignment: center; -fx-letter-spacing: 6px;"/>
                <Label fx:id="errorOtp" text="" styleClass="field-error"
                       visible="false" managed="false"/>
            </VBox>

            <!-- Message erreur global -->
            <Label fx:id="errorLabel" text="" wrapText="true"
                   managed="false" visible="false"
                   style="-fx-text-fill: #E53E3E; -fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-padding: 8 12 8 12; -fx-background-color: #fff5f5;
                          -fx-background-radius: 6; -fx-border-color: #FC8181;
                          -fx-border-radius: 6; -fx-border-width: 1;"/>

            <!-- Bouton Vérifier -->
            <Button fx:id="verifyButton" text="Vérifier le code" onAction="#handleVerify"
                    styleClass="btn-primary" maxWidth="Infinity" prefHeight="44"/>

            <!-- Renvoyer code -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="Code non reçu ?" styleClass="auth-right-sub"/>
                <Hyperlink text="Renvoyer" onAction="#handleResend"
                           style="-fx-text-fill: #2BBCB0; -fx-font-weight: bold;
                                  -fx-border-color: transparent;"/>
            </HBox>

            <!-- Retour -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="←" style="-fx-text-fill: #888; -fx-font-size: 13px;"/>
                <Hyperlink text="Retour" onAction="#goBack"
                           style="-fx-text-fill: #4A2D8F; -fx-font-weight: bold;
                                  -fx-border-color: transparent;"/>
            </HBox>
        </VBox>
    </VBox>

</HBox>
