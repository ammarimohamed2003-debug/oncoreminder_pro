<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginController" prefWidth="800" prefHeight="600" styleClass="root">
    <VBox maxWidth="400" spacing="20" styleClass="card" alignment="CENTER">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <Label text="Bienvenue" styleClass="title-text"/>
            <Label text="Connectez-vous à votre espace Santé &amp; Bien-être" styleClass="subtitle-text"/>
        </VBox>

        <VBox spacing="15" prefWidth="320">
            <VBox spacing="5">
                <Label text="Email" textFill="#4a5568"/>
                <TextField fx:id="emailField" promptText="nom@exemple.com" styleClass="text-field" prefHeight="40"/>
            </VBox>
            
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Mot de passe" textFill="#4a5568"/>
                    <HBox HBox.hgrow="ALWAYS" />
                    <Button text="Mot de passe oublié ?" styleClass="btn-link" />
                </HBox>
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="password-field" prefHeight="40"/>
            </VBox>
        </VBox>

        <Label fx:id="errorLabel" textFill="#e53e3e" visible="false"/>

        <Button text="Se connecter" onAction="#handleLogin" styleClass="btn-primary" maxWidth="Infinity" prefHeight="45"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Pas encore de compte ?" textFill="#718096"/>
            <Button text="S'inscrire" onAction="#goToSignUp" styleClass="btn-link"/>
        </HBox>
    </VBox>
</VBox>
