<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" styleClass="root-pane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.oncoreminder.controllers.LoginController">
    <children>
        <VBox alignment="CENTER" spacing="10.0" styleClass="form-panel" maxWidth="400.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <Label text="OncoReminder Pro" styleClass="brand-title" />
                <Label text="Connexion à votre espace santé" styleClass="brand-subtitle" />
                
                <VBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="Email" styleClass="field-label" />
                    <TextField fx:id="emailField" promptText="exemple@domain.com" styleClass="field-input" />
                </VBox>
                
                <VBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="Mot de passe" styleClass="field-label" />
                    <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="field-input" />
                </VBox>
                
                <Label fx:id="errorLabel" textFill="#e53e3e" wrapText="true" />
                
                <Button fx:id="loginButton" text="Se connecter" onAction="#handleLogin" styleClass="btn-primary" maxWidth="Infinity" />
                
                <HBox alignment="CENTER" spacing="5.0">
                    <Label text="Nouveau ici ?" styleClass="field-label" />
                    <Hyperlink text="Créer un compte" onAction="#goToSignUp" styleClass="brand-subtitle" />
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>