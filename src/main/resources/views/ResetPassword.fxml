<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.geometry.Insets?>

<HBox styleClass="root-pane" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.oncoreminder.controllers.ResetPasswordController">

    <!-- ═══ PANNEAU GAUCHE — Branding ═══ -->
    <VBox styleClass="auth-left" prefWidth="480" minWidth="380" alignment="CENTER" spacing="26">
        <padding><Insets bottom="60" left="50" right="50" top="60"/></padding>

        <StackPane>
            <Circle radius="75" fill="rgba(255,255,255,0.04)"/>
            <Circle radius="58" fill="rgba(255,255,255,0.07)"/>
            <Circle radius="42" fill="rgba(43,188,176,0.25)"/>
            <Circle radius="28" fill="rgba(43,188,176,0.45)"/>
            <Label text="⚕" style="-fx-font-size: 30px; -fx-text-fill: white;"/>
        </StackPane>

        <VBox alignment="CENTER" spacing="4">
            <Label text="OncoReminder" styleClass="auth-title"/>
            <Label text="P  R  O" styleClass="auth-subtitle"/>
        </VBox>

        <HBox alignment="CENTER" spacing="10">
            <Line startX="0" endX="60" stroke="rgba(255,255,255,0.25)" strokeWidth="1"/>
            <Circle radius="4" fill="#2BBCB0"/>
            <Line startX="0" endX="60" stroke="rgba(255,255,255,0.25)" strokeWidth="1"/>
        </HBox>

        <VBox alignment="CENTER" spacing="12">
            <Label text="Nouveau mot de passe"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2BBCB0;"/>
            <Label text="Créez un mot de passe sécurisé&#10;pour protéger votre compte."
                   styleClass="auth-tagline" alignment="CENTER" wrapText="true"/>
        </VBox>

        <!-- Règles de sécurité -->
        <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="280">
            <Label text="Règles de sécurité :"
                   style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <Label fx:id="ruleLength" text="● 8 caractères minimum"
                   style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 12px;"/>
            <Label fx:id="ruleUpper" text="● 1 lettre majuscule"
                   style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 12px;"/>
            <Label fx:id="ruleLower" text="● 1 lettre minuscule"
                   style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 12px;"/>
            <Label fx:id="ruleDigit" text="● 1 chiffre"
                   style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 12px;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
        <HBox spacing="8" alignment="CENTER">
            <Circle radius="5" fill="rgba(255,255,255,0.15)"/>
            <Circle radius="5" fill="rgba(255,255,255,0.15)"/>
            <Circle radius="5" fill="#2BBCB0"/>
        </HBox>
    </VBox>

    <!-- ═══ PANNEAU DROIT — Formulaire ═══ -->
    <VBox styleClass="auth-right" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="16">
        <padding><Insets bottom="60" left="80" right="80" top="60"/></padding>

        <StackPane>
            <Circle radius="32" fill="rgba(43,188,176,0.12)"/>
            <Circle radius="22" fill="rgba(43,188,176,0.20)"/>
            <Label text="🔐" style="-fx-font-size: 22px;"/>
        </StackPane>

        <Label text="Réinitialisation du mot de passe" styleClass="auth-right-title"/>
        <Label text="Créez un nouveau mot de passe sécurisé" styleClass="auth-right-sub"/>

        <VBox spacing="12" maxWidth="380" fillWidth="true">

            <!-- Nouveau mot de passe -->
            <VBox spacing="3">
                <Label text="Nouveau mot de passe" styleClass="field-label"/>
                <StackPane>
                    <PasswordField fx:id="passwordField" promptText="Minimum 8 caractères"
                                  styleClass="field-input" prefHeight="44"/>
                    <TextField fx:id="passwordVisible" promptText="Minimum 8 caractères"
                               styleClass="field-input" prefHeight="44"
                               visible="false" managed="false"/>
                </StackPane>
                <Label fx:id="errorPassword" text="" styleClass="field-error"
                       visible="false" managed="false"/>
            </VBox>

            <!-- Confirmer mot de passe -->
            <VBox spacing="3">
                <Label text="Confirmer le mot de passe" styleClass="field-label"/>
                <StackPane>
                    <PasswordField fx:id="confirmField" promptText="Répétez le mot de passe"
                                  styleClass="field-input" prefHeight="44"/>
                    <TextField fx:id="confirmVisible" promptText="Répétez le mot de passe"
                               styleClass="field-input" prefHeight="44"
                               visible="false" managed="false"/>
                </StackPane>
                <Label fx:id="errorConfirm" text="" styleClass="field-error"
                       visible="false" managed="false"/>
            </VBox>

            <!-- Checkbox afficher -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <CheckBox fx:id="showPasswordCheck" onAction="#toggleShowPassword"/>
                <Label text="Afficher le mot de passe"
                       style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Barre de force -->
            <VBox spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Force :" style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
                    <Label fx:id="strengthLabel" text=""
                           style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                </HBox>
                <ProgressBar fx:id="strengthBar" prefWidth="380" prefHeight="6" progress="0"/>
            </VBox>

            <!-- Erreur globale -->
            <Label fx:id="errorLabel" text="" wrapText="true"
                   managed="false" visible="false"
                   style="-fx-text-fill: #E53E3E; -fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-padding: 8 12 8 12; -fx-background-color: #fff5f5;
                          -fx-background-radius: 6; -fx-border-color: #FC8181;
                          -fx-border-radius: 6; -fx-border-width: 1;"/>

            <!-- Bouton confirmer -->
            <Button fx:id="confirmButton" text="Confirmer le nouveau mot de passe"
                    onAction="#handleResetPassword"
                    styleClass="btn-primary" maxWidth="Infinity" prefHeight="44"/>

            <!-- Retour -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="←" style="-fx-text-fill: #888; -fx-font-size: 13px;"/>
                <Hyperlink text="Retour" onAction="#goBack"
                           style="-fx-text-fill: #4A2D8F; -fx-font-weight: bold;
                                  -fx-border-color: transparent;"/>
            </HBox>
        </VBox>
    </VBox>

</HBox>
