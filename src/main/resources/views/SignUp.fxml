<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" styleClass="root-pane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.oncoreminder.controllers.SignUpController">
    <children>
        <VBox alignment="CENTER" spacing="15.0" styleClass="form-panel" maxWidth="450.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <Label text="Rejoindre OncoReminder" styleClass="form-title" />
                
                <HBox spacing="10.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Nom" styleClass="field-label" />
                        <TextField fx:id="nomField" styleClass="field-input" />
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Prénom" styleClass="field-label" />
                        <TextField fx:id="prenomField" styleClass="field-input" />
                    </VBox>
                </HBox>
                
                <VBox spacing="5.0">
                    <Label text="Email" styleClass="field-label" />
                    <TextField fx:id="emailField" styleClass="field-input" />
                </VBox>
                
                <VBox spacing="5.0">
                    <Label text="Mot de passe" styleClass="field-label" />
                    <PasswordField fx:id="passwordField" styleClass="field-input" />
                </VBox>
                
                <VBox spacing="5.0">
                    <Label text="Je suis un..." styleClass="field-label" />
                    <ComboBox fx:id="roleCombo" styleClass="field-combo" maxWidth="Infinity" />
                </VBox>
                
                <Label fx:id="errorLabel" textFill="#e53e3e" />
                
                <Button fx:id="signUpButton" text="Créer mon compte" onAction="#handleSignUp" styleClass="btn-primary" maxWidth="Infinity" />
                
                <Hyperlink text="Déjà inscrit ? Se connecter" onAction="#goToLogin" styleClass="brand-subtitle" />
            </children>
        </VBox>
    </children>
</VBox>
