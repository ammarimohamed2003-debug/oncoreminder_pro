<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<HBox styleClass="root-pane" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.oncoreminder.controllers.SignUpController">

    <!-- ═══ PANNEAU GAUCHE — Branding ═══ -->
    <VBox styleClass="auth-left" prefWidth="480" minWidth="380" alignment="CENTER" spacing="30">
        <padding><Insets bottom="60" left="50" right="50" top="60"/></padding>

        <!-- Logo -->
        <StackPane>
            <Circle radius="75" fill="rgba(255,255,255,0.04)"/>
            <Circle radius="58" fill="rgba(255,255,255,0.07)"/>
            <Circle radius="42" fill="rgba(43,188,176,0.25)"/>
            <Circle radius="28" fill="rgba(43,188,176,0.45)"/>
            <Label text="⚕" style="-fx-font-size: 30px; -fx-text-fill: white;"/>
        </StackPane>

        <VBox alignment="CENTER" spacing="4">
            <Label text="OncoReminder" styleClass="auth-title"/>
            <Label text="P  R  O" styleClass="auth-subtitle"/>
        </VBox>

        <HBox alignment="CENTER" spacing="10">
            <Line startX="0" endX="60" stroke="rgba(255,255,255,0.25)" strokeWidth="1"/>
            <Circle radius="4" fill="#2BBCB0"/>
            <Line startX="0" endX="60" stroke="rgba(255,255,255,0.25)" strokeWidth="1"/>
        </HBox>

        <Label text="Rejoignez la communauté médicale&#10;et gérez vos patients en toute sérénité"
               styleClass="auth-tagline" alignment="CENTER" wrapText="true"/>

        <VBox spacing="14" alignment="CENTER_LEFT" maxWidth="280">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane>
                    <Circle radius="16" fill="rgba(43,188,176,0.25)"/>
                    <Label text="👨‍⚕️" style="-fx-font-size: 14px;"/>
                </StackPane>
                <Label text="Espace Médecin dédié" styleClass="auth-feature-label"/>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane>
                    <Circle radius="16" fill="rgba(43,188,176,0.25)"/>
                    <Label text="👤" style="-fx-font-size: 14px;"/>
                </StackPane>
                <Label text="Espace Patient personnalisé" styleClass="auth-feature-label"/>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane>
                    <Circle radius="16" fill="rgba(43,188,176,0.25)"/>
                    <Label text="✅" style="-fx-font-size: 14px;"/>
                </StackPane>
                <Label text="Inscription rapide et gratuite" styleClass="auth-feature-label"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
        <HBox spacing="8" alignment="CENTER">
            <Circle radius="5" fill="rgba(255,255,255,0.15)"/>
            <Circle radius="5" fill="rgba(255,255,255,0.15)"/>
            <Circle radius="5" fill="#2BBCB0"/>
            <Circle radius="5" fill="rgba(255,255,255,0.15)"/>
        </HBox>
    </VBox>

    <!-- ═══ PANNEAU DROIT — Formulaire ═══ -->
    <VBox styleClass="auth-right" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="14">
        <padding><Insets bottom="40" left="80" right="80" top="40"/></padding>

        <StackPane>
            <Circle radius="28" fill="rgba(43,188,176,0.15)"/>
            <Label text="⚕" style="-fx-font-size: 22px; -fx-text-fill: #2BBCB0;"/>
        </StackPane>

        <Label text="Créer un compte" styleClass="auth-right-title"/>
        <Label text="Rejoignez OncoReminder Pro gratuitement" styleClass="auth-right-sub"/>

        <VBox spacing="10" maxWidth="400" fillWidth="true">
            <HBox spacing="12">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Nom" styleClass="field-label"/>
                    <TextField fx:id="nomField" styleClass="field-input" prefHeight="40"/>
                    <Label fx:id="errorNom" text="" styleClass="field-error" visible="false" managed="false"/>
                </VBox>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Prénom" styleClass="field-label"/>
                    <TextField fx:id="prenomField" styleClass="field-input" prefHeight="40"/>
                    <Label fx:id="errorPrenom" text="" styleClass="field-error" visible="false" managed="false"/>
                </VBox>
            </HBox>

            <VBox spacing="3">
                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField" styleClass="field-input" prefHeight="40"/>
                <Label fx:id="errorEmail" text="" styleClass="field-error" visible="false" managed="false"/>
            </VBox>

            <VBox spacing="3">
                <Label text="Mot de passe" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" styleClass="field-input" prefHeight="40"/>
                <Label fx:id="errorPassword" text="" styleClass="field-error" visible="false" managed="false"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Je suis un..." styleClass="field-label"/>
                <ComboBox fx:id="roleCombo" styleClass="field-combo"
                          maxWidth="Infinity" prefHeight="40"/>
            </VBox>

            <Button fx:id="signUpButton" text="Créer mon compte" onAction="#handleSignUp"
                    styleClass="btn-primary" maxWidth="Infinity" prefHeight="44"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Déjà inscrit ?" styleClass="auth-right-sub"/>
                <Hyperlink text="Se connecter" onAction="#goToLogin"
                           style="-fx-text-fill: #2BBCB0; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>

</HBox>
