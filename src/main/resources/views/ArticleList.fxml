<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="root-pane" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.ArticleListController">

    <top>
        <HBox spacing="20.0" styleClass="topbar" alignment="CENTER_LEFT">
            <padding><Insets bottom="15" left="20" right="20" top="15"/></padding>
            <VBox>
                <Label text="OncoReminder Pro" styleClass="brand-title"/>
                <Label text="Articles Médicaux" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="12" alignment="CENTER">
                <Button fx:id="newArticleBtn" text="+ Nouvel Article" onAction="#handleNewArticle"
                        styleClass="btn-primary" prefWidth="140"/>
                <Label fx:id="userNameLabel" text="Chargement..." styleClass="stat-label"/>
                <Button text="Retour" onAction="#handleBack" styleClass="btn-outline" prefWidth="80"/>
                <Button text="Déconnexion" onAction="#handleLogout" styleClass="btn-outline" prefWidth="110"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <HBox spacing="20">
            <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

            <!-- Liste articles -->
            <VBox spacing="12" prefWidth="360" minWidth="300">
                <HBox fx:id="filterBar" spacing="10" alignment="CENTER_LEFT">
                    <Button text="Tous" onAction="#filterAll" styleClass="btn-outline" prefWidth="100"/>
                    <Button text="Mes Articles" onAction="#filterMine" styleClass="btn-outline" prefWidth="120"/>
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <VBox fx:id="articleListContainer" spacing="10">
                        <padding><Insets bottom="10" left="5" right="5" top="5"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Détail article + commentaires -->
            <VBox styleClass="form-panel" HBox.hgrow="ALWAYS" spacing="0">
                <padding><Insets bottom="25" left="25" right="25" top="25"/></padding>

                <Label fx:id="placeholderLabel" text="Sélectionnez un article pour voir son contenu"
                       styleClass="form-title" alignment="CENTER" maxWidth="Infinity"/>

                <VBox fx:id="detailContent" spacing="14" visible="false" managed="false">

                    <!-- En-tête article -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="articleTitreLabel" text="" styleClass="form-title"
                               wrapText="true" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statutBadge" text="" styleClass="stat-badge-info"/>
                    </HBox>

                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Label fx:id="dateLabel" text="" styleClass="stat-label"/>
                        <Label fx:id="organeLabel" text="" styleClass="stat-label"/>
                    </HBox>

                    <Separator/>

                    <!-- Contenu -->
                    <TextArea fx:id="contenuArea" editable="false" wrapText="true"
                              prefHeight="140" styleClass="field-input"/>

                    <!-- Actions like + médecin -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="❤ J'aime" onAction="#handleLike" styleClass="btn-outline" prefWidth="90"/>
                        <Label fx:id="likesLabel" text="0 likes" styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox fx:id="medecinActions" spacing="8" alignment="CENTER" visible="false" managed="false">
                            <Button text="Modifier" onAction="#handleEdit" styleClass="btn-outline" prefWidth="85"/>
                            <Button fx:id="publishBtn" text="Publier" onAction="#handlePublish"
                                    styleClass="btn-primary" prefWidth="80"/>
                            <Button fx:id="archiveBtn" text="Archiver" onAction="#handleArchive"
                                    styleClass="btn-warning" prefWidth="85"/>
                            <Button text="Supprimer" onAction="#handleDelete"
                                    styleClass="btn-danger" prefWidth="95"/>
                        </HBox>
                    </HBox>

                    <Separator/>

                    <!-- Commentaires -->
                    <Label text="Commentaires" styleClass="section-title"/>

                    <ScrollPane fitToWidth="true" prefHeight="180">
                        <VBox fx:id="commentsContainer" spacing="8">
                            <padding><Insets bottom="5" left="5" right="5" top="5"/></padding>
                        </VBox>
                    </ScrollPane>

                    <!-- Ajouter un commentaire -->
                    <HBox spacing="10" alignment="CENTER">
                        <TextField fx:id="commentField" promptText="Votre commentaire..."
                                   styleClass="field-input" HBox.hgrow="ALWAYS"/>
                        <Button text="Commenter" onAction="#handleAddComment"
                                styleClass="btn-primary" prefWidth="110"/>
                    </HBox>

                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
