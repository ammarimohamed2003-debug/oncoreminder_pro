<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="root-pane bg-articles" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.ArticleListController">

    <!-- ── Sidebar médecin (partagée) ── -->
    <left>
        <fx:include fx:id="doctorSidebar" source="DoctorSidebar.fxml"/>
    </left>

    <!-- ── Centre : grille ou détail ── -->
    <center>
        <StackPane>

            <!-- ══ VUE GRILLE ══ -->
            <VBox fx:id="gridView" spacing="0">

                <!-- Topbar simplifiée -->
                <HBox spacing="10" styleClass="topbar" alignment="CENTER_LEFT">
                    <padding><Insets bottom="10" left="20" right="20" top="10"/></padding>

                    <Label text="📰 Articles Médicaux" styleClass="brand-title"/>
                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox fx:id="filterBar" spacing="6" alignment="CENTER">
                        <Button text="Tous"         onAction="#filterAll"  styleClass="btn-outline"
                                prefHeight="36" minWidth="70" style="-fx-padding: 0 16;"/>
                        <Button text="Mes Articles" onAction="#filterMine" styleClass="btn-outline"
                                prefHeight="36" minWidth="120" style="-fx-padding: 0 16;"/>
                    </HBox>

                    <TextField fx:id="searchField" promptText="🔍 Rechercher..."
                               styleClass="field-input" prefWidth="220" prefHeight="36"/>

                    <Button fx:id="newArticleBtn" text="+ Nouvel Article" onAction="#handleNewArticle"
                            styleClass="btn-primary" prefHeight="36" minWidth="140"
                            style="-fx-padding: 0 18;"/>
                </HBox>

                <!-- Barre filtres statut (médecin) -->
                <HBox fx:id="statutFilterBar" spacing="6" alignment="CENTER_LEFT"
                      visible="false" managed="false"
                      style="-fx-background-color: white; -fx-padding: 7 20;
                             -fx-border-color: transparent transparent #E9E4F7 transparent;
                             -fx-border-width: 1;">
                    <Label text="Statut :"
                           style="-fx-text-fill: #718096; -fx-font-size: 11px; -fx-padding: 0 4 0 0;"/>
                    <Button fx:id="btnStatutTous"      text="Tous"       onAction="#filterStatutAll"
                            prefHeight="27" style="-fx-background-color: #5B35A5; -fx-text-fill: white;
                                   -fx-padding: 3 12; -fx-background-radius: 7; -fx-font-size: 10px; -fx-cursor: hand;"/>
                    <Button fx:id="btnStatutPublie"    text="✅ PUBLIÉ"   onAction="#filterStatutPublie"
                            prefHeight="27" style="-fx-background-color: #C6F6D5; -fx-text-fill: #276749;
                                   -fx-padding: 3 10; -fx-background-radius: 7; -fx-font-size: 10px; -fx-cursor: hand;"/>
                    <Button fx:id="btnStatutBrouillon" text="📝 BROUILLON" onAction="#filterStatutBrouillon"
                            prefHeight="27" style="-fx-background-color: #FEF3C7; -fx-text-fill: #D97706;
                                   -fx-padding: 3 10; -fx-background-radius: 7; -fx-font-size: 10px; -fx-cursor: hand;"/>
                    <Button fx:id="btnStatutArchive"   text="📦 ARCHIVÉ"  onAction="#filterStatutArchive"
                            prefHeight="27" style="-fx-background-color: #E2E8F0; -fx-text-fill: #4A5568;
                                   -fx-padding: 3 10; -fx-background-radius: 7; -fx-font-size: 10px; -fx-cursor: hand;"/>
                </HBox>

                <!-- Grille scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: #F7F4FE; -fx-background: #F7F4FE;">
                    <FlowPane fx:id="articleFlowPane" hgap="20" vgap="20" alignment="TOP_LEFT"
                              style="-fx-background-color: transparent;">
                        <padding><Insets bottom="24" left="24" right="24" top="24"/></padding>
                    </FlowPane>
                </ScrollPane>

                <!-- Barre de pagination -->
                <HBox fx:id="paginationBar" spacing="8" alignment="CENTER"
                      style="-fx-background-color: white;
                             -fx-border-color: #DDD6F8;
                             -fx-border-width: 1 0 0 0;
                             -fx-effect: dropshadow(gaussian, rgba(90,53,165,0.08), 6, 0, 0, -2);
                             -fx-padding: 8 24;"/>
            </VBox>

            <!-- ══ VUE DÉTAIL ══ -->
            <VBox fx:id="detailView" spacing="0" visible="false" managed="false">

                <!-- Topbar détail : retour + titre + badge -->
                <HBox spacing="14" styleClass="topbar" alignment="CENTER_LEFT">
                    <padding><Insets bottom="10" left="20" right="20" top="10"/></padding>
                    <Button text="← Articles" onAction="#handleBackToGrid"
                            styleClass="btn-outline" prefHeight="36" minWidth="115"
                            style="-fx-padding: 0 16;"/>
                    <Label fx:id="articleTitreLabel" text="" styleClass="brand-subtitle"
                           wrapText="false" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label fx:id="statutBadge" text="" styleClass="stat-badge-info"/>
                </HBox>

                <!-- Contenu scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: #F7F4FE; -fx-background: #F7F4FE;">
                    <VBox spacing="0" style="-fx-background-color: #F7F4FE;">

                        <!-- Image hero -->
                        <StackPane fx:id="imageContainer" prefHeight="340"
                                   visible="false" managed="false"
                                   style="-fx-background-color: #12002E;">
                            <ImageView fx:id="detailImageView"
                                       fitWidth="1600" fitHeight="340"
                                       preserveRatio="true" smooth="true"/>
                        </StackPane>

                        <!-- Zone principale -->
                        <VBox spacing="18" style="-fx-background-color: #F7F4FE;">
                            <padding><Insets top="24" right="32" bottom="44" left="32"/></padding>

                            <!-- Métadonnées -->
                            <HBox spacing="14" alignment="CENTER_LEFT"
                                  style="-fx-background-color: white; -fx-background-radius: 12;
                                         -fx-border-color: #EDE9F8; -fx-border-radius: 12;
                                         -fx-border-width: 1; -fx-padding: 14 18;">
                                <Label fx:id="organeLabel" text=""
                                       style="-fx-background-color: #EEF2FF; -fx-text-fill: #5B35A5;
                                              -fx-background-radius: 20; -fx-font-size: 12px;
                                              -fx-font-weight: bold; -fx-padding: 4 12;"/>
                                <Label fx:id="medecinLabel" text=""
                                       style="-fx-background-color: rgba(43,188,176,0.12); -fx-text-fill: #2BBCB0;
                                              -fx-background-radius: 20; -fx-font-size: 12px;
                                              -fx-font-weight: bold; -fx-padding: 4 12;"
                                       visible="false" managed="false"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="dateLabel"  text="" styleClass="stat-label"/>
                                <Label text="|" style="-fx-text-fill: #D1C4E9;"/>
                                <Label fx:id="viewsLabel" text="" styleClass="stat-label"/>
                                <Label fx:id="tagsLabel"  text="" styleClass="stat-label"
                                       visible="false" managed="false"/>
                            </HBox>

                            <!-- Contenu -->
                            <VBox style="-fx-background-color: white; -fx-background-radius: 14;
                                         -fx-border-color: #EDE9F8; -fx-border-radius: 14;
                                         -fx-border-width: 1; -fx-padding: 26;">
                                <VBox fx:id="contenuContainer" spacing="6" minHeight="80"/>
                            </VBox>

                            <!-- Actions -->
                            <HBox spacing="12" alignment="CENTER_LEFT"
                                  style="-fx-background-color: white; -fx-background-radius: 12;
                                         -fx-border-color: #EDE9F8; -fx-border-radius: 12;
                                         -fx-border-width: 1; -fx-padding: 12 18;">
                                <Button fx:id="likeBtn" text="❤  J'aime" onAction="#handleLike"
                                        styleClass="btn-outline" prefHeight="38" minWidth="130"
                                        style="-fx-padding: 0 20; -fx-font-size: 13px;"/>
                                <Label fx:id="likesLabel" text="0 likes" styleClass="stat-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <HBox fx:id="medecinActions" spacing="10" alignment="CENTER"
                                      visible="false" managed="false">
                                    <Button text="✏  Modifier" onAction="#handleEdit"
                                            styleClass="btn-outline" prefHeight="38" minWidth="120"
                                            style="-fx-padding: 0 16;"/>
                                    <Button fx:id="publishBtn" text="▶  Publier" onAction="#handlePublish"
                                            styleClass="btn-primary" prefHeight="38" minWidth="110"
                                            style="-fx-padding: 0 16;"/>
                                    <Button fx:id="archiveBtn" text="📦  Archiver" onAction="#handleArchive"
                                            styleClass="btn-warning" prefHeight="38" minWidth="120"
                                            style="-fx-padding: 0 16;"/>
                                    <Button text="🗑  Supprimer" onAction="#handleDelete"
                                            styleClass="btn-danger" prefHeight="38" minWidth="120"
                                            style="-fx-padding: 0 16;"/>
                                </HBox>
                            </HBox>

                            <!-- Évaluation article -->
                            <VBox fx:id="evalSection" spacing="10" visible="false" managed="false"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-padding: 18 22;">
                                <Label fx:id="evalTitre" text="⭐  Évaluez cet article"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3A1D7A;"/>
                                <Separator style="-fx-background-color: #EDE9F8;"/>
                                <HBox fx:id="evalStarsBox" spacing="6" alignment="CENTER_LEFT"/>
                                <Label fx:id="evalMessage" text="" wrapText="true"
                                       visible="false" managed="false"
                                       style="-fx-text-fill: #5B35A5; -fx-font-size: 12px; -fx-font-style: italic;"/>
                                <VBox fx:id="evalListBox" spacing="6"
                                      visible="false" managed="false"
                                      style="-fx-padding: 8 0 0 0;"/>
                            </VBox>

                            <!-- Commentaires -->
                            <VBox spacing="14"
                                  style="-fx-background-color: white; -fx-background-radius: 14;
                                         -fx-border-color: #EDE9F8; -fx-border-radius: 14;
                                         -fx-border-width: 1; -fx-padding: 22;">
                                <Label text="💬 Commentaires"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3A1D7A;"/>
                                <Separator style="-fx-background-color: #EDE9F8;"/>
                                <VBox fx:id="commentsContainer" spacing="10" minHeight="40"/>
                                <VBox spacing="6">
                                    <HBox alignment="CENTER_RIGHT">
                                        <Button fx:id="emojiBtn" text="😊  Émojis" onAction="#handleEmojiPicker"
                                                style="-fx-background-color: #F3F0FF; -fx-text-fill: #5B35A5;
                                                       -fx-background-radius: 8; -fx-border-width: 0;
                                                       -fx-font-family: 'Segoe UI Emoji';
                                                       -fx-padding: 5 12; -fx-font-size: 12px; -fx-cursor: hand;"/>
                                    </HBox>
                                    <HBox spacing="12" alignment="CENTER">
                                        <TextArea fx:id="commentField" promptText="Votre commentaire..."
                                                  styleClass="field-input" HBox.hgrow="ALWAYS"
                                                  prefHeight="72" wrapText="true"/>
                                        <Button text="Envoyer →" onAction="#handleAddComment"
                                                styleClass="btn-primary" minWidth="120" prefHeight="72"
                                                style="-fx-padding: 0 18; -fx-font-size: 13px;"/>
                                    </HBox>
                                </VBox>
                            </VBox>

                        </VBox>
                    </VBox>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
