<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="root-pane bg-articles" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.ArticleListController">

    <center>
        <StackPane>

            <!-- ══ VUE GRILLE ══ -->
            <VBox fx:id="gridView" spacing="0">

                <!-- Barre du haut -->
                <HBox spacing="10" styleClass="topbar" alignment="CENTER_LEFT">
                    <padding><Insets bottom="10" left="20" right="20" top="10"/></padding>

                    <!-- Branding -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <StackPane>
                            <Circle radius="20" fill="rgba(43,188,176,0.20)"/>
                            <Label text="⚕" style="-fx-font-size:18px; -fx-text-fill:#2BBCB0;"/>
                        </StackPane>
                        <VBox>
                            <Label text="OncoReminder Pro" styleClass="brand-title"/>
                            <Label text="Articles Médicaux" styleClass="brand-subtitle"/>
                        </VBox>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Filtres médecin -->
                    <HBox fx:id="filterBar" spacing="6" alignment="CENTER">
                        <Button text="Tous"         onAction="#filterAll"  styleClass="btn-outline"
                                prefHeight="36" minWidth="70" style="-fx-padding: 0 16;"/>
                        <Button text="Mes Articles" onAction="#filterMine" styleClass="btn-outline"
                                prefHeight="36" minWidth="120" style="-fx-padding: 0 16;"/>
                    </HBox>

                    <!-- Recherche -->
                    <TextField fx:id="searchField" promptText="🔍 Rechercher..."
                               styleClass="field-input" prefWidth="220" prefHeight="36"/>

                    <!-- Actions -->
                    <Button fx:id="newArticleBtn" text="+ Nouvel Article" onAction="#handleNewArticle"
                            styleClass="btn-primary" prefHeight="36" minWidth="140"
                            style="-fx-padding: 0 18;"/>
                    <Label fx:id="userNameLabel" text="" styleClass="stat-label"/>
                    <Button text="Retour"      onAction="#handleBack"   styleClass="btn-outline"
                            prefHeight="36" minWidth="80" style="-fx-padding: 0 14;"/>
                    <Button text="Déconnexion" onAction="#handleLogout" styleClass="btn-outline"
                            prefHeight="36" minWidth="110" style="-fx-padding: 0 14;"/>
                </HBox>

                <!-- Grille scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <FlowPane fx:id="articleFlowPane" hgap="16" vgap="16"
                              style="-fx-background-color: transparent;">
                        <padding><Insets bottom="24" left="20" right="20" top="20"/></padding>
                    </FlowPane>
                </ScrollPane>
            </VBox>

            <!-- ══ VUE DÉTAIL ══ -->
            <VBox fx:id="detailView" spacing="0" visible="false" managed="false">

                <!-- Barre retour + titre -->
                <HBox spacing="14" styleClass="topbar" alignment="CENTER_LEFT">
                    <padding><Insets bottom="10" left="20" right="20" top="10"/></padding>
                    <Button text="← Articles" onAction="#handleBackToGrid"
                            styleClass="btn-outline" prefHeight="36" minWidth="115"
                            style="-fx-padding: 0 16;"/>
                    <Label fx:id="articleTitreLabel" text="" styleClass="brand-title"
                           wrapText="true" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statutBadge" text="" styleClass="stat-badge-info"/>
                </HBox>

                <!-- Contenu scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox spacing="14">
                        <padding><Insets bottom="30" left="30" right="30" top="20"/></padding>

                        <!-- Métadonnées -->
                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <Label fx:id="dateLabel"   text="" styleClass="stat-label"/>
                            <Label fx:id="organeLabel" text="" styleClass="stat-label"/>
                            <Label fx:id="viewsLabel"  text="" styleClass="stat-label"/>
                        </HBox>

                        <!-- Tags -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label fx:id="tagsLabel" text="" styleClass="stat-label"
                                   visible="false" managed="false"/>
                        </HBox>

                        <Separator/>

                        <!-- Contenu Markdown -->
                        <VBox fx:id="contenuContainer" spacing="5" minHeight="80"
                              style="-fx-background-color: #F8F4FF; -fx-background-radius: 8;
                                     -fx-border-color: #D6CBFF; -fx-border-radius: 8;
                                     -fx-border-width: 1; -fx-padding: 14;"/>

                        <Separator/>

                        <!-- Like -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button fx:id="likeBtn" text="❤  J'aime" onAction="#handleLike"
                                    styleClass="btn-outline" prefHeight="40" minWidth="130"
                                    style="-fx-padding: 0 20; -fx-font-size: 13px;"/>
                            <Label fx:id="likesLabel" text="0 likes" styleClass="stat-label"/>
                        </HBox>

                        <!-- Actions médecin -->
                        <HBox fx:id="medecinActions" spacing="12" alignment="CENTER_LEFT"
                              visible="false" managed="false">
                            <Button text="✏  Modifier"   onAction="#handleEdit"
                                    styleClass="btn-outline"
                                    prefHeight="40" minWidth="130" style="-fx-padding: 0 18;"/>
                            <Button fx:id="publishBtn"  text="▶  Publier"   onAction="#handlePublish"
                                    styleClass="btn-primary"
                                    prefHeight="40" minWidth="120" style="-fx-padding: 0 18;"/>
                            <Button fx:id="archiveBtn"  text="📦  Archiver" onAction="#handleArchive"
                                    styleClass="btn-warning"
                                    prefHeight="40" minWidth="130" style="-fx-padding: 0 18;"/>
                            <Button text="🗑  Supprimer" onAction="#handleDelete"
                                    styleClass="btn-danger"
                                    prefHeight="40" minWidth="130" style="-fx-padding: 0 18;"/>
                        </HBox>

                        <Separator/>

                        <!-- Commentaires -->
                        <Label text="Commentaires" styleClass="section-title"/>
                        <VBox fx:id="commentsContainer" spacing="10" minHeight="80"/>

                        <HBox spacing="12" alignment="CENTER">
                            <TextArea fx:id="commentField" promptText="Votre commentaire..."
                                      styleClass="field-input" HBox.hgrow="ALWAYS"
                                      prefHeight="70" wrapText="true"/>
                            <Button text="Commenter" onAction="#handleAddComment"
                                    styleClass="btn-primary" minWidth="130" prefHeight="70"
                                    style="-fx-padding: 0 18; -fx-font-size: 13px;"/>
                        </HBox>

                    </VBox>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
