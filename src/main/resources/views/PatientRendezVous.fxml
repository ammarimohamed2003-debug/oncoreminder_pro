<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.oncoreminder.controllers.PatientRendezVousController">

    <!-- ══ SIDEBAR PATIENT ══ -->
    <left>
        <fx:include fx:id="patientSidebar" source="PatientSidebar.fxml"/>
    </left>

    <!-- ══ CONTENU ══ -->
    <center>
        <HBox spacing="0" style="-fx-background-color:#F5F7FF;">

            <!-- ══ Formulaire gauche ══ -->
            <VBox prefWidth="330" spacing="12"
                  style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:0 1 0 0;-fx-padding:20 18 20 18;">

                <Label fx:id="formTitleLabel" text="📅 Demander un rendez-vous"
                       wrapText="true"
                       style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;-fx-padding:0 0 8 0;-fx-border-color:#EEF4FB;-fx-border-width:0 0 2 0;"/>

                <!-- Spécialité -->
                <VBox spacing="4">
                    <Label text="Spécialité *" style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                    <ComboBox fx:id="specialiteComboBox" maxWidth="1.7976931348623157E308"
                              promptText="Choisir une spécialité..."
                              style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;-fx-border-width:1.5;"/>
                </VBox>

                <!-- Médecin -->
                <VBox spacing="4">
                    <Label text="Médecin *" style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                    <ComboBox fx:id="medecinComboBox" maxWidth="1.7976931348623157E308"
                              promptText="Choisissez d'abord une spécialité"
                              style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;-fx-border-width:1.5;"/>
                    <Label fx:id="medecinCountLabel" text=""
                           style="-fx-font-size:10px;-fx-text-fill:#9CA3AF;"/>
                </VBox>

                <!-- Date -->
                <VBox spacing="4">
                    <Label text="Date souhaitée *" style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                    <DatePicker fx:id="datePicker" maxWidth="1.7976931348623157E308"
                                style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1.5;"/>
                </VBox>

                <!-- Heure -->
                <VBox spacing="4">
                    <Label text="Heure *" style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                    <TextField fx:id="timeField" promptText="Ex: 10:30"
                               style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:13px;-fx-padding:8 12;-fx-border-width:1.5;"/>
                </VBox>

                <!-- Lieu -->
                <VBox spacing="4">
                    <Label text="Lieu (optionnel)" style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                    <TextField fx:id="lieuField" promptText="Ex: Hôpital Charles Nicolle"
                               style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:13px;-fx-padding:8 12;-fx-border-width:1.5;"/>
                </VBox>

                <!-- Motif -->
                <VBox spacing="4" VBox.vgrow="ALWAYS">
                    <Label text="Motif / Notes (optionnel)" style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                    <TextArea fx:id="notesArea" prefHeight="80" wrapText="true"
                              promptText="Décrivez vos symptômes ou la raison de la consultation..."
                              style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;-fx-border-width:1.5;"/>
                </VBox>

                <Label fx:id="formMessageLabel" wrapText="true"
                       style="-fx-font-size:12px;-fx-text-fill:#059669;-fx-font-weight:bold;"/>

                <Button fx:id="submitBtn" text="📅 Envoyer la demande" onAction="#onSubmit"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color:#2BBCB0;-fx-text-fill:white;-fx-background-radius:10;-fx-font-weight:bold;-fx-font-size:13px;-fx-padding:11 0;-fx-cursor:hand;"/>
                <Button fx:id="cancelEditBtn" text="✕ Annuler la modification" onAction="#onCancelEdit"
                        maxWidth="1.7976931348623157E308" visible="false" managed="false"
                        style="-fx-background-color:transparent;-fx-text-fill:#DC2626;-fx-border-color:#DC2626;-fx-border-width:1.5;-fx-background-radius:10;-fx-font-size:12px;-fx-padding:8 0;-fx-cursor:hand;"/>
            </VBox>

            <!-- ══ Panneau droit ══ -->
            <VBox HBox.hgrow="ALWAYS" spacing="0">

                <!-- Top bar stats -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="topbar"
                      style="-fx-padding:12 16 12 16;">
                    <Label text="Mes Rendez-vous &amp; Ordonnances"
                           style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;"/>
                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Stat: Total -->
                    <VBox alignment="CENTER"
                          style="-fx-background-color:#F0F4FF;-fx-background-radius:16;-fx-border-color:#D0D8F0;-fx-border-radius:16;-fx-border-width:1.5;-fx-padding:3 10;">
                        <Label text="Total" style="-fx-font-size:9px;-fx-text-fill:#4A2D8F;-fx-font-weight:bold;"/>
                        <Label fx:id="totalLabel" text="0" style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#2BBCB0;"/>
                    </VBox>
                    <!-- Stat: En attente -->
                    <VBox alignment="CENTER"
                          style="-fx-background-color:#FFF8E7;-fx-background-radius:16;-fx-border-color:#F6E6A0;-fx-border-radius:16;-fx-border-width:1.5;-fx-padding:3 10;">
                        <Label text="En attente" style="-fx-font-size:9px;-fx-text-fill:#D97706;-fx-font-weight:bold;"/>
                        <Label fx:id="attenteLabel" text="0" style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#D97706;"/>
                    </VBox>
                    <!-- Stat: Acceptés -->
                    <VBox alignment="CENTER"
                          style="-fx-background-color:#ECFDF5;-fx-background-radius:16;-fx-border-color:#A7F3D0;-fx-border-radius:16;-fx-border-width:1.5;-fx-padding:3 10;">
                        <Label text="Acceptés" style="-fx-font-size:9px;-fx-text-fill:#059669;-fx-font-weight:bold;"/>
                        <Label fx:id="accepteLabel" text="0" style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#059669;"/>
                    </VBox>

                    <Button text="↻ Actualiser" onAction="#onRefresh"
                            style="-fx-background-color:transparent;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-padding:5 10;-fx-cursor:hand;-fx-font-size:11px;"/>
                </HBox>

                <!-- Scrollable cards area -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color:#F5F7FF;-fx-background:transparent;-fx-border-color:transparent;-fx-padding:0;">
                    <VBox spacing="0" style="-fx-padding:14 16 20 16;-fx-background-color:#F5F7FF;">

                        <!-- ── Section Rendez-vous ── -->
                        <HBox alignment="CENTER_LEFT" spacing="8"
                              style="-fx-padding:0 0 10 0;-fx-border-color:#E2E8F0;-fx-border-width:0 0 2 0;-fx-margin-bottom:10;">
                            <Label text="📅" style="-fx-font-size:15px;"/>
                            <Label text="Mes Rendez-vous"
                                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;"/>
                            <Label fx:id="statusLabel" text=""
                                   style="-fx-font-size:11px;-fx-text-fill:#9CA3AF;-fx-padding:0 0 0 6;"/>
                        </HBox>

                        <VBox fx:id="rdvCardsBox" spacing="10" style="-fx-padding:0 0 20 0;">
                            <!-- RDV cards injected here -->
                            <Label fx:id="rdvEmptyLabel" text="Aucun rendez-vous. Faites votre première demande !"
                                   style="-fx-text-fill:#B0C4D8;-fx-font-style:italic;-fx-font-size:13px;-fx-padding:10 0;"/>
                        </VBox>

                        <!-- ── Section Ordonnances ── -->
                        <HBox alignment="CENTER_LEFT" spacing="8"
                              style="-fx-padding:6 0 10 0;-fx-border-color:#E2E8F0;-fx-border-width:2 0 2 0;">
                            <Label text="💊" style="-fx-font-size:15px;"/>
                            <Label text="Mes Ordonnances"
                                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;"/>
                            <Label fx:id="ordStatusLabel" text=""
                                   style="-fx-font-size:11px;-fx-text-fill:#9CA3AF;-fx-padding:0 0 0 6;"/>
                        </HBox>

                        <VBox fx:id="ordCardsBox" spacing="10" style="-fx-padding:10 0 0 0;">
                            <!-- Ordonnance cards injected here -->
                            <Label fx:id="ordEmptyLabel" text="Aucune ordonnance disponible."
                                   style="-fx-text-fill:#B0C4D8;-fx-font-style:italic;-fx-font-size:13px;-fx-padding:10 0;"/>
                        </VBox>

                    </VBox>
                </ScrollPane>

            </VBox>
        </HBox>
    </center>
</BorderPane>
