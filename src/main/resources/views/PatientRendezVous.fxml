<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.oncoreminder.controllers.PatientRendezVousController">

    <left>
        <fx:include fx:id="patientSidebar" source="PatientSidebar.fxml"/>
    </left>

    <center>
        <HBox spacing="0" style="-fx-background-color:#F5F7FF;">

            <!-- ══ FORMULAIRE ══ -->
            <VBox prefWidth="320" spacing="0"
                  style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:0 1 0 0;">

                <!-- En-tête formulaire -->
                <VBox style="-fx-padding:18 18 14 18;-fx-border-color:#F0EDF8;-fx-border-width:0 0 2 0;">
                    <Label fx:id="formTitleLabel" text="Nouveau rendez-vous"
                           style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;"/>
                    <Label text="Remplissez les étapes ci-dessous"
                           style="-fx-font-size:11px;-fx-text-fill:#94A3B8;-fx-padding:2 0 0 0;"/>
                </VBox>

                <!-- Corps du formulaire scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color:white;-fx-background:white;-fx-border-color:transparent;-fx-padding:0;">
                    <VBox spacing="16" style="-fx-padding:16 18 12 18;-fx-background-color:white;">

                        <!-- ── Étape 1 : Spécialité ── -->
                        <VBox spacing="7">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="1"
                                       style="-fx-background-color:#4A2D8F;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:bold;-fx-min-width:20;-fx-min-height:20;-fx-max-width:20;-fx-max-height:20;-fx-background-radius:20;-fx-alignment:center;"/>
                                <Label text="Spécialité médicale"
                                       style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
                            </HBox>
                            <ComboBox fx:id="specialiteComboBox" maxWidth="1.7976931348623157E308"
                                      promptText="Choisir une spécialité..."
                                      style="-fx-background-color:#F8F6FF;-fx-border-color:#D0C4F0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;-fx-border-width:1.5;"/>
                        </VBox>

                        <!-- ── Étape 2 : Médecin ── -->
                        <VBox spacing="7">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="2"
                                       style="-fx-background-color:#4A2D8F;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:bold;-fx-min-width:20;-fx-min-height:20;-fx-max-width:20;-fx-max-height:20;-fx-background-radius:20;-fx-alignment:center;"/>
                                <Label text="Choisir un médecin"
                                       style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
                                <Label fx:id="medecinCountLabel" text=""
                                       style="-fx-font-size:10px;-fx-text-fill:#9CA3AF;"/>
                            </HBox>
                            <ComboBox fx:id="medecinComboBox" maxWidth="1.7976931348623157E308"
                                      promptText="Choisissez d'abord une spécialité"
                                      style="-fx-background-color:#F8F6FF;-fx-border-color:#D0C4F0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;-fx-border-width:1.5;"/>

                            <!-- Aperçu médecin sélectionné -->
                            <HBox fx:id="doctorPreviewBox" spacing="10" alignment="CENTER_LEFT"
                                  visible="false" managed="false"
                                  style="-fx-background-color:#F0EDF8;-fx-background-radius:10;-fx-padding:10 12;-fx-border-color:#D0C4F0;-fx-border-radius:10;-fx-border-width:1;">
                                <Label fx:id="doctorAvatarLabel" text="?"
                                       style="-fx-background-color:#4A2D8F;-fx-text-fill:white;-fx-font-size:14px;-fx-font-weight:bold;-fx-min-width:38;-fx-min-height:38;-fx-max-width:38;-fx-max-height:38;-fx-background-radius:20;-fx-alignment:center;"/>
                                <VBox spacing="2">
                                    <Label fx:id="doctorNameLabel" text=""
                                           style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1E293B;"/>
                                    <Label fx:id="doctorSpecLabel" text=""
                                           style="-fx-font-size:11px;-fx-text-fill:#5B35A5;-fx-background-color:#E9E3F8;-fx-background-radius:10;-fx-padding:2 8;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- ── Étape 3 : Date &amp; Heure ── -->
                        <VBox spacing="7">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="3"
                                       style="-fx-background-color:#4A2D8F;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:bold;-fx-min-width:20;-fx-min-height:20;-fx-max-width:20;-fx-max-height:20;-fx-background-radius:20;-fx-alignment:center;"/>
                                <Label text="Date &amp; Heure"
                                       style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
                            </HBox>
                            <HBox spacing="8">
                                <DatePicker fx:id="datePicker" HBox.hgrow="ALWAYS"
                                            style="-fx-background-color:#F8F6FF;-fx-border-color:#D0C4F0;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1.5;"/>
                                <TextField fx:id="timeField" prefWidth="76" promptText="HH:mm"
                                           style="-fx-background-color:#F8F6FF;-fx-border-color:#D0C4F0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:13px;-fx-padding:8 10;-fx-border-width:1.5;"/>
                            </HBox>
                            <Label fx:id="dateHintLabel" text=""
                                   style="-fx-font-size:11px;-fx-text-fill:#059669;-fx-font-weight:bold;"/>
                        </VBox>

                        <!-- ── Étape 4 : Lieu &amp; Motif ── -->
                        <VBox spacing="7">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="4"
                                       style="-fx-background-color:#94A3B8;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:bold;-fx-min-width:20;-fx-min-height:20;-fx-max-width:20;-fx-max-height:20;-fx-background-radius:20;-fx-alignment:center;"/>
                                <Label text="Lieu &amp; Motif"
                                       style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>
                                <Label text="(optionnel)"
                                       style="-fx-font-size:10px;-fx-text-fill:#94A3B8;"/>
                            </HBox>
                            <TextField fx:id="lieuField" promptText="Ex: Hôpital Charles Nicolle, Tunis"
                                       style="-fx-background-color:#F8F6FF;-fx-border-color:#D0C4F0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;-fx-padding:8 12;-fx-border-width:1.5;"/>
                            <TextArea fx:id="notesArea" prefHeight="75" wrapText="true"
                                      promptText="Décrivez vos symptômes ou la raison de la consultation..."
                                      style="-fx-background-color:#F8F6FF;-fx-border-color:#D0C4F0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;-fx-border-width:1.5;"/>
                        </VBox>

                    </VBox>
                </ScrollPane>

                <!-- Pied de formulaire (fixe) -->
                <VBox spacing="8" style="-fx-padding:12 18 16 18;-fx-border-color:#F0EDF8;-fx-border-width:2 0 0 0;-fx-background-color:white;">
                    <Label fx:id="formMessageLabel" wrapText="true"
                           style="-fx-font-size:11px;-fx-text-fill:#059669;-fx-font-weight:bold;"/>
                    <Button fx:id="submitBtn" text="📅 Envoyer la demande" onAction="#onSubmit"
                            maxWidth="1.7976931348623157E308"
                            style="-fx-background-color:#4A2D8F;-fx-text-fill:white;-fx-background-radius:10;-fx-font-weight:bold;-fx-font-size:13px;-fx-padding:11 0;-fx-cursor:hand;"/>
                    <Button fx:id="cancelEditBtn" text="✕ Annuler la modification" onAction="#onCancelEdit"
                            maxWidth="1.7976931348623157E308" visible="false" managed="false"
                            style="-fx-background-color:transparent;-fx-text-fill:#DC2626;-fx-border-color:#DC2626;-fx-border-width:1.5;-fx-background-radius:10;-fx-font-size:12px;-fx-padding:8 0;-fx-cursor:hand;"/>
                </VBox>
            </VBox>

            <!-- ══ PANNEAU DROIT ══ -->
            <VBox HBox.hgrow="ALWAYS" spacing="0">

                <!-- Top bar stats -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="topbar"
                      style="-fx-padding:12 16 12 16;">
                    <Label fx:id="formTitleLabel2" text="Mes rendez-vous"
                           style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER"
                          style="-fx-background-color:#F0F4FF;-fx-background-radius:16;-fx-border-color:#D0D8F0;-fx-border-radius:16;-fx-border-width:1.5;-fx-padding:3 10;">
                        <Label text="Total" style="-fx-font-size:9px;-fx-text-fill:#4A2D8F;-fx-font-weight:bold;"/>
                        <Label fx:id="totalLabel" text="0" style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#2BBCB0;"/>
                    </VBox>
                    <VBox alignment="CENTER"
                          style="-fx-background-color:#FFF8E7;-fx-background-radius:16;-fx-border-color:#F6E6A0;-fx-border-radius:16;-fx-border-width:1.5;-fx-padding:3 10;">
                        <Label text="En attente" style="-fx-font-size:9px;-fx-text-fill:#D97706;-fx-font-weight:bold;"/>
                        <Label fx:id="attenteLabel" text="0" style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#D97706;"/>
                    </VBox>
                    <VBox alignment="CENTER"
                          style="-fx-background-color:#ECFDF5;-fx-background-radius:16;-fx-border-color:#A7F3D0;-fx-border-radius:16;-fx-border-width:1.5;-fx-padding:3 10;">
                        <Label text="Acceptés" style="-fx-font-size:9px;-fx-text-fill:#059669;-fx-font-weight:bold;"/>
                        <Label fx:id="accepteLabel" text="0" style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#059669;"/>
                    </VBox>
                    <Button text="↻" onAction="#onRefresh"
                            style="-fx-background-color:transparent;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-padding:5 10;-fx-cursor:hand;"/>
                </HBox>

                <!-- Zone de cartes scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color:#F5F7FF;-fx-background:transparent;-fx-border-color:transparent;">
                    <VBox spacing="0" style="-fx-padding:14 16 24 16;-fx-background-color:#F5F7FF;">

                        <!-- Section À venir -->
                        <HBox alignment="CENTER_LEFT" spacing="8"
                              style="-fx-padding:0 0 10 2;">
                            <Label text="📅  À venir"
                                   style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;"/>
                            <Label fx:id="statusLabel" text=""
                                   style="-fx-font-size:11px;-fx-text-fill:#9CA3AF;"/>
                        </HBox>
                        <VBox fx:id="rdvCardsBox" spacing="10" style="-fx-padding:0 0 20 0;">
                            <Label fx:id="rdvEmptyLabel"
                                   text="Aucun rendez-vous à venir. Faites votre première demande !"
                                   style="-fx-text-fill:#B0C4D8;-fx-font-style:italic;-fx-font-size:12px;-fx-padding:8 0;"/>
                        </VBox>

                        <!-- Section Historique -->
                        <HBox alignment="CENTER_LEFT" spacing="8"
                              style="-fx-padding:4 0 10 2;-fx-border-color:#E2E8F0;-fx-border-width:2 0 0 0;">
                            <Label text="🕐  Historique"
                                   style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#94A3B8;"/>
                            <Label fx:id="histStatusLabel" text=""
                                   style="-fx-font-size:11px;-fx-text-fill:#9CA3AF;"/>
                        </HBox>
                        <VBox fx:id="histCardsBox" spacing="10" style="-fx-padding:0 0 20 0;">
                            <Label fx:id="histEmptyLabel" text="Aucun historique."
                                   style="-fx-text-fill:#B0C4D8;-fx-font-style:italic;-fx-font-size:12px;-fx-padding:8 0;"/>
                        </VBox>

                        <!-- Section Ordonnances -->
                        <HBox alignment="CENTER_LEFT" spacing="8"
                              style="-fx-padding:4 0 10 2;-fx-border-color:#E2E8F0;-fx-border-width:2 0 0 0;">
                            <Label text="💊  Mes Ordonnances"
                                   style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;"/>
                            <Label fx:id="ordStatusLabel" text=""
                                   style="-fx-font-size:11px;-fx-text-fill:#9CA3AF;"/>
                        </HBox>
                        <VBox fx:id="ordCardsBox" spacing="10" style="-fx-padding:10 0 0 0;">
                            <Label fx:id="ordEmptyLabel" text="Aucune ordonnance disponible."
                                   style="-fx-text-fill:#B0C4D8;-fx-font-style:italic;-fx-font-size:12px;-fx-padding:8 0;"/>
                        </VBox>

                    </VBox>
                </ScrollPane>

            </VBox>
        </HBox>
    </center>
</BorderPane>
