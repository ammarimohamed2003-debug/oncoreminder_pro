<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.oncoreminder.controllers.OrdonnanceController">

    <!-- ══ SIDEBAR MÉDECIN (partagée) ══ -->
    <left>
        <fx:include fx:id="doctorSidebar" source="DoctorSidebar.fxml"/>
    </left>

    <!-- ══ CONTENU ══ -->
    <center>
        <HBox spacing="0" style="-fx-background-color:#F5F7FF;">

            <!-- Formulaire gauche -->
            <VBox prefWidth="360" spacing="14" style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:0 1 0 0;-fx-padding:20 20 20 20;">

                <!-- Top bar formulaire -->
                <HBox alignment="CENTER_LEFT" style="-fx-padding:0 0 10 0;-fx-border-color:#EEF4FB;-fx-border-width:0 0 2 0;">
                    <Label fx:id="selectedIdLabel" text="Nouvelle ordonnance" style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;"/>
                </HBox>

                <!-- RDV ComboBox -->
                <VBox spacing="5">
                    <Label text="Rendez-vous concerné *" style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                    <ComboBox fx:id="rdvComboBox" maxWidth="1.7976931348623157E308" style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:12px;-fx-border-width:1.5;"/>
                    <Label text="Seuls les rendez-vous acceptés sont disponibles." style="-fx-font-size:10px;-fx-text-fill:#9CA3AF;"/>
                </VBox>

                <!-- Date & Durée -->
                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Date d'émission *" style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                        <DatePicker fx:id="issueDatePicker" maxWidth="1.7976931348623157E308" style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1.5;"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Durée (jours) *" style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                        <TextField fx:id="durationField" promptText="Ex: 7" style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:13px;-fx-padding:8 10;-fx-border-width:1.5;"/>
                    </VBox>
                </HBox>

                <!-- Médicaments -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="Médicaments *" style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                    <TextArea fx:id="medicationArea" prefHeight="90" promptText="Ex: Paracétamol 1g, Ibuprofène 400mg..." wrapText="true"
                              style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:13px;-fx-border-width:1.5;"/>
                </VBox>

                <!-- Posologie -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="Posologie / Dosage *" style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#5B35A5;"/>
                    <TextArea fx:id="dosageArea" prefHeight="90" promptText="Ex: 1 comprimé matin et soir après repas..." wrapText="true"
                              style="-fx-background-color:#F4F9FF;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:13px;-fx-border-width:1.5;"/>
                </VBox>

                <Label fx:id="formMessageLabel" wrapText="true" style="-fx-font-size:12px;-fx-text-fill:#6B7280;"/>

                <Separator/>
                <HBox spacing="8">
                    <Button maxWidth="1.7976931348623157E308" onAction="#onSave" text="Enregistrer" HBox.hgrow="ALWAYS"
                            style="-fx-background-color:#2BBCB0;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:9 0;-fx-cursor:hand;"/>
                    <Button maxWidth="1.7976931348623157E308" onAction="#onUpdate" text="Modifier" HBox.hgrow="ALWAYS"
                            style="-fx-background-color:#F6AD55;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:9 0;-fx-cursor:hand;"/>
                    <Button maxWidth="1.7976931348623157E308" onAction="#onDelete" text="Supprimer" HBox.hgrow="ALWAYS"
                            style="-fx-background-color:#FC8181;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:9 0;-fx-cursor:hand;"/>
                </HBox>
                <Button onAction="#onNew" text="+ Nouvelle ordonnance" maxWidth="1.7976931348623157E308"
                        style="-fx-background-color:transparent;-fx-text-fill:#4A2D8F;-fx-border-color:#5B35A5;-fx-border-width:1.5;-fx-background-radius:8;-fx-cursor:hand;-fx-padding:7 0;"/>
            </VBox>

            <!-- Table droite -->
            <VBox HBox.hgrow="ALWAYS" spacing="0">
                <!-- Top bar table -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar" style="-fx-padding:14 20 14 20;">
                    <VBox>
                        <Label text="Ordonnances" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER" style="-fx-background-color:#F0F4FF;-fx-background-radius:20;-fx-border-color:#D0D8F0;-fx-border-radius:20;-fx-border-width:1.5;-fx-padding:4 14;">
                        <Label text="Aujourd'hui" style="-fx-font-size:10px;-fx-text-fill:#4A2D8F;-fx-font-weight:bold;"/>
                        <Label fx:id="todayCountLabel" text="00" style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:#2BBCB0;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color:#F0F4FF;-fx-background-radius:20;-fx-border-color:#D0D8F0;-fx-border-radius:20;-fx-border-width:1.5;-fx-padding:4 14;">
                        <Label text="Semaine" style="-fx-font-size:10px;-fx-text-fill:#4A2D8F;-fx-font-weight:bold;"/>
                        <Label fx:id="weekCountLabel" text="00" style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:#2BBCB0;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color:#F0F4FF;-fx-background-radius:20;-fx-border-color:#D0D8F0;-fx-border-radius:20;-fx-border-width:1.5;-fx-padding:4 14;">
                        <Label text="Total" style="-fx-font-size:10px;-fx-text-fill:#4A2D8F;-fx-font-weight:bold;"/>
                        <Label fx:id="totalCountLabel" text="00" style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:#2BBCB0;"/>
                    </VBox>
                    <Button text="↻" onAction="#onRefresh" style="-fx-background-color:transparent;-fx-border-color:#C8DCF0;-fx-border-radius:8;-fx-padding:6 12;-fx-cursor:hand;"/>
                    <Button text="📄 Export PDF" onAction="#onExport" style="-fx-background-color:transparent;-fx-text-fill:#4A2D8F;-fx-border-color:#5B35A5;-fx-border-width:1.5;-fx-border-radius:8;-fx-padding:6 12;-fx-cursor:hand;"/>
                </HBox>
                <!-- Filtres -->
                <HBox spacing="10" style="-fx-padding:12 20 8 20;-fx-background-color:#F5F7FF;">
                    <TextField fx:id="searchField" promptText="🔍 Rechercher..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="filterComboBox" prefWidth="160" styleClass="field-combo"/>
                </HBox>
                <!-- Table -->
                <VBox VBox.vgrow="ALWAYS" style="-fx-padding:0 20 0 20;">
                    <TableView fx:id="prescriptionTable" VBox.vgrow="ALWAYS" styleClass="main-table">
                        <columns>
                            <TableColumn fx:id="idColumn"          prefWidth="50"  text="ID"/>
                            <TableColumn fx:id="rendezVousColumn"  prefWidth="80"  text="RDV ID"/>
                            <TableColumn fx:id="emissionDateColumn" prefWidth="110" text="Date émission"/>
                            <TableColumn fx:id="durationColumn"    prefWidth="80"  text="Durée (j)"/>
                            <TableColumn fx:id="medicamentsColumn" prefWidth="200" text="Médicaments"/>
                            <TableColumn fx:id="posologieColumn"   prefWidth="200" text="Posologie"/>
                        </columns>
                        <placeholder><Label text="Aucune ordonnance trouvée." style="-fx-text-fill:#B0C4D8;-fx-font-style:italic;"/></placeholder>
                    </TableView>
                </VBox>
                <!-- Footer -->
                <HBox alignment="CENTER_LEFT" style="-fx-background-color:white;-fx-border-color:#C8DCF0;-fx-border-width:1 0 0 0;-fx-padding:10 20;">
                    <Label fx:id="footerStatusLabel" text="Chargement..." style="-fx-text-fill:#6B7280;-fx-font-size:12px;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>