<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>

<BorderPane styleClass="root-pane bg-dashboard" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.PatientDashboardController">

    <!-- ══════════════ SIDEBAR ══════════════ -->
    <left>
        <VBox prefWidth="255" styleClass="patient-sidebar">

            <!-- Branding -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-padding: 18 18 15 18;
                         -fx-border-color: transparent transparent rgba(255,255,255,0.10) transparent;
                         -fx-border-width: 0 0 1 0;">
                <StackPane>
                    <Circle radius="17" fill="rgba(43,188,176,0.15)"/>
                    <Circle radius="17" fill="transparent" stroke="#2BBCB0" strokeWidth="1.5"/>
                    <Rectangle width="5" height="16" fill="white" arcWidth="4" arcHeight="4"/>
                    <Rectangle width="16" height="5" fill="white" arcWidth="4" arcHeight="4"/>
                    <Circle radius="2.5" fill="#2BBCB0"/>
                </StackPane>
                <VBox spacing="2">
                    <HBox spacing="0">
                        <Label text="Onco" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Reminder" style="-fx-text-fill: #2BBCB0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="PRO" style="-fx-background-color: rgba(43,188,176,0.25); -fx-text-fill: #2BBCB0;
                                   -fx-background-radius: 4; -fx-padding: 1 6; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Avatar -->
            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 20 16 16 16;">
                <StackPane>
                    <Circle radius="44" fill="#2BBCB0" opacity="0.12"/>
                    <Circle radius="38" fill="#2D1B69"/>
                    <Circle radius="33" fill="#5B35A5"/>
                    <Label text="👤" style="-fx-font-size: 26px;"/>
                </StackPane>
                <Label fx:id="patientNameLabel" text="Patient"
                       style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-alignment: center;"
                       wrapText="true" maxWidth="210" textAlignment="CENTER" alignment="CENTER"/>
                <Label text="Patient"
                       style="-fx-background-color: rgba(43,188,176,0.20); -fx-text-fill: #2BBCB0;
                              -fx-background-radius: 20; -fx-padding: 3 14; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <Label fx:id="medecinSidebarLabel" text=""
                       style="-fx-text-fill: rgba(255,255,255,0.70); -fx-font-size: 10px; -fx-padding: 2 0 0 0;"
                       visible="false" managed="false" wrapText="true" maxWidth="200" textAlignment="CENTER"/>
            </VBox>

            <!-- Divider -->
            <Pane prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.10);">
                <VBox.margin><Insets left="18" right="18" bottom="6"/></VBox.margin>
            </Pane>

            <!-- Navigation -->
            <VBox spacing="2" style="-fx-padding: 10 10 0 10;">
                <Label text="NAVIGATION"
                       style="-fx-text-fill: rgba(255,255,255,0.32); -fx-font-size: 10px;
                              -fx-font-weight: bold; -fx-padding: 0 8 5 8;"/>
                <Button fx:id="btnMaSante" text="🏠  Ma Santé" onAction="#handleMaSante"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn-active"/>
                <Button text="📰  Articles" onAction="#handleArticles"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button fx:id="btnEvenements" text="📅  Événements" onAction="#handleRendezVous"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button fx:id="btnReclamations" text="📣  Réclamations" onAction="#handleReclamations"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button fx:id="btnRdvModule" text="🏥  Mes Rendez-vous" onAction="#handleRdvModule"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button fx:id="btnOrdoModule" text="📝  Mes Ordonnances" onAction="#handleOrdoModule"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Divider avant logout -->
            <Pane prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.10);">
                <VBox.margin><Insets left="18" right="18" top="6"/></VBox.margin>
            </Pane>

            <!-- Logout -->
            <VBox style="-fx-padding: 8 10 18 10;">
                <Button text="🔓  Déconnexion" onAction="#handleLogout"
                        maxWidth="Infinity" styleClass="sidebar-logout-btn"/>
            </VBox>

        </VBox>
    </left>

    <!-- ══════════════ CONTENU ══════════════ -->
    <center>
        <StackPane>
        <TabPane fx:id="patientTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="tab-pane">

            <!-- ════ ONGLET 1 — DOSSIER MÉDICAL ════ -->
            <tabs>
            <Tab text="🏥  Mon Dossier Médical">
                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: #F5F7FF; -fx-background: #F5F7FF;
                                   -fx-border-color: transparent;">
                    <VBox spacing="24">
                        <padding><Insets bottom="40" left="40" right="40" top="28"/></padding>

                        <!-- En-tête -->
                        <VBox spacing="4">
                            <Label text="Bienvenue dans votre espace santé"
                                   styleClass="dashboard-welcome"/>
                            <Label text="Gérez vos informations médicales en toute sécurité."
                                   styleClass="brand-subtitle"/>
                        </VBox>

                        <!-- Stats rapides -->
                        <HBox spacing="20">
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5">
                                <padding><Insets bottom="18" left="15" right="15" top="18"/></padding>
                                <Label text="🩸  GROUPE SANGUIN" styleClass="stat-label"/>
                                <Label fx:id="bloodGroupLabelDisplay" text="--" styleClass="stat-value"
                                       style="-fx-text-fill: #FC8181;"/>
                            </VBox>
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5">
                                <padding><Insets bottom="18" left="15" right="15" top="18"/></padding>
                                <Label text="⚖️  POIDS ACTUEL" styleClass="stat-label"/>
                                <HBox alignment="CENTER" spacing="4">
                                    <Label fx:id="poidsLabelDisplay" text="--" styleClass="stat-value"/>
                                    <Label text="kg" styleClass="stat-label"/>
                                </HBox>
                            </VBox>
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5">
                                <padding><Insets bottom="18" left="15" right="15" top="18"/></padding>
                                <Label text="📏  TAILLE" styleClass="stat-label"/>
                                <HBox alignment="CENTER" spacing="4">
                                    <Label fx:id="tailleLabelDisplay" text="--" styleClass="stat-value"/>
                                    <Label text="cm" styleClass="stat-label"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- Formulaire dossier médical -->
                        <VBox spacing="20" styleClass="form-panel">
                            <padding><Insets bottom="28" left="28" right="28" top="24"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="📋" style="-fx-font-size: 20px;"/>
                                <Label text="Dossier Médical Personnalisé" styleClass="form-title"/>
                            </HBox>
                            <Separator/>

                            <!-- Ligne 1 : Groupe sanguin + Poids + Taille -->
                            <HBox spacing="16">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Groupe Sanguin" styleClass="field-label"/>
                                    <ComboBox fx:id="groupeSanguinCombo" styleClass="field-combo"
                                              maxWidth="Infinity" prefHeight="40"/>
                                    <Label fx:id="errorGroupeSanguin" text="" styleClass="field-error"
                                           visible="false" managed="false"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Poids (kg)" styleClass="field-label"/>
                                    <TextField fx:id="poidsField" promptText="ex: 70.5"
                                               styleClass="field-input" prefHeight="40"/>
                                    <Label fx:id="errorPoids" text="" styleClass="field-error"
                                           visible="false" managed="false"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Taille (cm)" styleClass="field-label"/>
                                    <TextField fx:id="tailleField" promptText="ex: 175"
                                               styleClass="field-input" prefHeight="40"/>
                                    <Label fx:id="errorTaille" text="" styleClass="field-error"
                                           visible="false" managed="false"/>
                                </VBox>
                            </HBox>

                            <!-- Antécédents + Allergies -->
                            <HBox spacing="16">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="🏥  Antécédents Médicaux" styleClass="field-label"/>
                                    <TextArea fx:id="antecedentsArea" styleClass="field-input"
                                              wrapText="true" prefHeight="110"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="⚠️  Allergies &amp; Contre-indications" styleClass="field-label"/>
                                    <TextArea fx:id="allergiesArea" styleClass="field-input"
                                              wrapText="true" prefHeight="110"/>
                                </VBox>
                            </HBox>

                            <!-- Traitements -->
                            <VBox spacing="4">
                                <Label text="💊  Traitements en cours" styleClass="field-label"/>
                                <TextArea fx:id="traitementsArea" styleClass="field-input"
                                          wrapText="true" prefHeight="80"
                                          promptText="Listez vos traitements actuels..."/>
                            </VBox>

                            <!-- Feedback + Bouton -->
                            <Label fx:id="medFeedbackLabel" text="" wrapText="true"
                                   visible="false" managed="false"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-padding: 8 12 8 12; -fx-background-radius: 6;
                                          -fx-border-radius: 6; -fx-border-width: 1;"/>

                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <Button fx:id="saveMedBtn" text="💾  Enregistrer le dossier"
                                        onAction="#handleSaveMedicalRecord"
                                        styleClass="btn-primary" prefHeight="42" prefWidth="240"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ════ ONGLET 2 — MON PROFIL ════ -->
            <Tab text="👤  Mon Profil">
                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: #F5F7FF; -fx-background: #F5F7FF;
                                   -fx-border-color: transparent;">
                    <VBox spacing="24">
                        <padding><Insets bottom="40" left="40" right="40" top="28"/></padding>

                        <!-- Informations personnelles -->
                        <VBox spacing="18" styleClass="form-panel">
                            <padding><Insets bottom="28" left="28" right="28" top="24"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="👤" style="-fx-font-size: 20px;"/>
                                <Label text="Informations Personnelles" styleClass="form-title"/>
                            </HBox>
                            <Separator/>

                            <!-- Nom + Prénom -->
                            <HBox spacing="16">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Nom" styleClass="field-label"/>
                                    <TextField fx:id="profileNomField" styleClass="field-input" prefHeight="40"/>
                                    <Label fx:id="profileErrorNom" text="" styleClass="field-error"
                                           visible="false" managed="false"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Prénom" styleClass="field-label"/>
                                    <TextField fx:id="profilePrenomField" styleClass="field-input" prefHeight="40"/>
                                    <Label fx:id="profileErrorPrenom" text="" styleClass="field-error"
                                           visible="false" managed="false"/>
                                </VBox>
                            </HBox>

                            <!-- Email -->
                            <VBox spacing="4">
                                <Label text="Email" styleClass="field-label"/>
                                <TextField fx:id="profileEmailField" styleClass="field-input" prefHeight="40"/>
                                <Label fx:id="profileErrorEmail" text="" styleClass="field-error"
                                       visible="false" managed="false"/>
                            </VBox>

                            <!-- Téléphone + Sexe -->
                            <HBox spacing="16">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Téléphone" styleClass="field-label"/>
                                    <TextField fx:id="profileTelField" promptText="+213 XX XX XX XX"
                                               styleClass="field-input" prefHeight="40"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Sexe" styleClass="field-label"/>
                                    <ComboBox fx:id="profileSexeCombo" styleClass="field-combo"
                                              maxWidth="Infinity" prefHeight="40"/>
                                </VBox>
                            </HBox>

                            <!-- Date naissance -->
                            <VBox spacing="4">
                                <Label text="Date de naissance (JJ/MM/AAAA)" styleClass="field-label"/>
                                <TextField fx:id="profileDateNaissField" promptText="ex: 15/03/1990"
                                           styleClass="field-input" prefHeight="40"/>
                            </VBox>

                            <!-- Adresse -->
                            <VBox spacing="4">
                                <Label text="Adresse" styleClass="field-label"/>
                                <TextField fx:id="profileAdresseField"
                                           promptText="N° Rue, Ville, Code postal"
                                           styleClass="field-input" prefHeight="40"/>
                            </VBox>

                            <!-- Feedback profil -->
                            <Label fx:id="profileFeedbackLabel" text="" wrapText="true"
                                   visible="false" managed="false"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-padding: 8 12 8 12; -fx-background-radius: 6;
                                          -fx-border-radius: 6; -fx-border-width: 1;"/>

                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <Button text="✕  Annuler" onAction="#handleCancelProfile"
                                        styleClass="btn-secondary" prefHeight="40" prefWidth="120"/>
                                <Button fx:id="saveProfileBtn" text="💾  Enregistrer le profil"
                                        onAction="#handleSaveProfile"
                                        styleClass="btn-primary" prefHeight="40" prefWidth="220"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ════ ONGLET 3 — SÉCURITÉ ════ -->
            <Tab text="🔐  Sécurité">
                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: #F5F7FF; -fx-background: #F5F7FF;
                                   -fx-border-color: transparent;">
                    <VBox spacing="24">
                        <padding><Insets bottom="40" left="40" right="40" top="28"/></padding>

                        <!-- Changement de mot de passe -->
                        <VBox spacing="18" styleClass="form-panel" maxWidth="560">
                            <padding><Insets bottom="28" left="28" right="28" top="24"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🔐" style="-fx-font-size: 20px;"/>
                                <Label text="Modifier le mot de passe" styleClass="form-title"/>
                            </HBox>
                            <Separator/>

                            <Label text="Pour modifier votre mot de passe, entrez d'abord votre mot de passe actuel."
                                   wrapText="true"
                                   style="-fx-text-fill: #888; -fx-font-size: 12px;"/>

                            <!-- Ancien mot de passe -->
                            <VBox spacing="4">
                                <Label text="Mot de passe actuel" styleClass="field-label"/>
                                <StackPane>
                                    <PasswordField fx:id="oldPwdField"
                                                   promptText="Votre mot de passe actuel"
                                                   styleClass="field-input" prefHeight="42"/>
                                    <TextField fx:id="oldPwdVisible"
                                               promptText="Votre mot de passe actuel"
                                               styleClass="field-input" prefHeight="42"
                                               visible="false" managed="false"/>
                                </StackPane>
                                <Label fx:id="errorOldPwd" text="" styleClass="field-error"
                                       visible="false" managed="false"/>
                            </VBox>

                            <!-- Nouveau mot de passe -->
                            <VBox spacing="4">
                                <Label text="Nouveau mot de passe" styleClass="field-label"/>
                                <StackPane>
                                    <PasswordField fx:id="newPwdField"
                                                   promptText="Minimum 8 caractères"
                                                   styleClass="field-input" prefHeight="42"/>
                                    <TextField fx:id="newPwdVisible"
                                               promptText="Minimum 8 caractères"
                                               styleClass="field-input" prefHeight="42"
                                               visible="false" managed="false"/>
                                </StackPane>
                                <Label fx:id="errorNewPwd" text="" styleClass="field-error"
                                       visible="false" managed="false"/>
                            </VBox>

                            <!-- Confirmation -->
                            <VBox spacing="4">
                                <Label text="Confirmer le nouveau mot de passe" styleClass="field-label"/>
                                <StackPane>
                                    <PasswordField fx:id="confirmPwdField"
                                                   promptText="Répétez le nouveau mot de passe"
                                                   styleClass="field-input" prefHeight="42"/>
                                    <TextField fx:id="confirmPwdVisible"
                                               promptText="Répétez le nouveau mot de passe"
                                               styleClass="field-input" prefHeight="42"
                                               visible="false" managed="false"/>
                                </StackPane>
                                <Label fx:id="errorConfirmPwd" text="" styleClass="field-error"
                                       visible="false" managed="false"/>
                            </VBox>

                            <!-- Toggle show -->
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <CheckBox fx:id="showPwdCheck" onAction="#toggleShowPassword"/>
                                <Label text="Afficher les mots de passe"
                                       style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                            </HBox>

                            <!-- Feedback -->
                            <Label fx:id="pwdFeedbackLabel" text="" wrapText="true"
                                   visible="false" managed="false"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-padding: 8 12 8 12; -fx-background-radius: 6;
                                          -fx-border-radius: 6; -fx-border-width: 1;"/>

                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <Button text="✕  Annuler" onAction="#handleCancelPassword"
                                        styleClass="btn-secondary" prefHeight="40" prefWidth="120"/>
                                <Button fx:id="savePwdBtn" text="🔐  Changer le mot de passe"
                                        onAction="#handleChangePassword"
                                        styleClass="btn-primary" prefHeight="40" prefWidth="240"/>
                            </HBox>
                        </VBox>

                        <!-- Conseils de sécurité -->
                        <VBox spacing="12" styleClass="form-panel"
                              style="-fx-border-color: #2BBCB0; -fx-border-width: 2 0 0 0;">
                            <padding><Insets bottom="20" left="24" right="24" top="20"/></padding>
                            <Label text="💡  Conseils de sécurité" styleClass="form-title"
                                   style="-fx-font-size: 14px;"/>
                            <Label text="• Utilisez au moins 8 caractères avec majuscules, chiffres et symboles."
                                   style="-fx-text-fill: #555; -fx-font-size: 12px;"/>
                            <Label text="• Ne partagez jamais votre mot de passe avec quelqu'un."
                                   style="-fx-text-fill: #555; -fx-font-size: 12px;"/>
                            <Label text="• Changez votre mot de passe régulièrement (tous les 3 mois)."
                                   style="-fx-text-fill: #555; -fx-font-size: 12px;"/>
                            <Label text="• Évitez d'utiliser votre date de naissance ou votre nom."
                                   style="-fx-text-fill: #555; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>
            </tabs>
        </TabPane>

        <!-- Zone événements -->
        <VBox fx:id="patientEventsPane" visible="false" managed="false">
            <fx:include fx:id="patientEventContent" source="PatientEventContent.fxml" VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- Zone réservations -->
        <VBox fx:id="patientReservationsPane" visible="false" managed="false">
            <fx:include fx:id="patientReservationContent" source="ReservationContent.fxml" VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- Zone réclamations -->
        <VBox fx:id="patientReclamationsPane" visible="false" managed="false">
            <fx:include fx:id="patientReclamationContent" source="ReclamationPatient.fxml" VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox fx:id="rdvModulePane" visible="false" managed="false">
            <fx:include source="../com/onco/rendez-vous-view.fxml" VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox fx:id="ordoModulePane" visible="false" managed="false">
            <fx:include source="../com/onco/ordonnance-view.fxml" VBox.vgrow="ALWAYS"/>
        </VBox>

        </StackPane>
    </center>

</BorderPane>