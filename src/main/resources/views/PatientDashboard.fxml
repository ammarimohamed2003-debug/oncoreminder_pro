<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>

<BorderPane styleClass="root-pane bg-dashboard" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.oncoreminder.controllers.PatientDashboardController">
    <left>
        <VBox prefWidth="255" styleClass="patient-sidebar">

            <!-- Branding -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-padding: 18 18 15 18;
                         -fx-border-color: transparent transparent rgba(255,255,255,0.10) transparent;
                         -fx-border-width: 0 0 1 0;">
                <StackPane>
                    <Circle radius="17" fill="rgba(43,188,176,0.15)"/>
                    <Circle radius="17" fill="transparent" stroke="#2BBCB0" strokeWidth="1.5"/>
                    <Rectangle width="5" height="16" fill="white" arcWidth="4" arcHeight="4"/>
                    <Rectangle width="16" height="5" fill="white" arcWidth="4" arcHeight="4"/>
                    <Circle radius="2.5" fill="#2BBCB0"/>
                </StackPane>
                <VBox spacing="2">
                    <HBox spacing="0">
                        <Label text="Onco" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Reminder" style="-fx-text-fill: #2BBCB0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="PRO" style="-fx-background-color: rgba(43,188,176,0.25); -fx-text-fill: #2BBCB0;
                                   -fx-background-radius: 4; -fx-padding: 1 6; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Avatar -->
            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 20 16 16 16;">
                <StackPane>
                    <Circle radius="44" fill="#2BBCB0" opacity="0.12"/>
                    <Circle radius="38" fill="#2D1B69"/>
                    <Circle radius="33" fill="#5B35A5"/>
                    <Label text="👤" style="-fx-font-size: 26px;"/>
                </StackPane>
                <Label fx:id="patientNameLabel" text="Patient Name"
                       style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"
                       wrapText="true" maxWidth="210" textAlignment="CENTER"/>
                <Label text="Patient"
                       style="-fx-background-color: rgba(43,188,176,0.20); -fx-text-fill: #2BBCB0;
                              -fx-background-radius: 20; -fx-padding: 3 14; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <Label fx:id="medecinSidebarLabel" text=""
                       style="-fx-text-fill: rgba(255,255,255,0.70); -fx-font-size: 10px; -fx-padding: 2 0 0 0;"
                       visible="false" managed="false" wrapText="true" maxWidth="200" textAlignment="CENTER"/>
            </VBox>

            <!-- Divider -->
            <Pane prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.10);">
                <VBox.margin><Insets left="18" right="18" bottom="6"/></VBox.margin>
            </Pane>

            <!-- Navigation -->
            <VBox spacing="2" style="-fx-padding: 10 10 0 10;">
                <Label text="NAVIGATION"
                       style="-fx-text-fill: rgba(255,255,255,0.32); -fx-font-size: 10px;
                              -fx-font-weight: bold; -fx-padding: 0 8 5 8;"/>
                <Button text="🏠  Ma Santé"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn-active"/>
                <Button text="📰  Articles" onAction="#handleArticles"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button text="📅  Rendez-vous"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button text="💊  Traitements"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button text="⚙️  Paramètres"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Divider avant logout -->
            <Pane prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.10);">
                <VBox.margin><Insets left="18" right="18" top="6"/></VBox.margin>
            </Pane>

            <!-- Logout -->
            <VBox style="-fx-padding: 8 10 18 10;">
                <Button text="🔓  Déconnexion" onAction="#handleLogout"
                        maxWidth="Infinity" styleClass="sidebar-logout-btn"/>
            </VBox>

        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="stat-scroll-pane">
            <content>
                <VBox spacing="30.0">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>
                        <VBox spacing="5.0">
                            <Label text="Bienvenue dans votre espace santé" styleClass="dashboard-welcome" />
                            <Label text="Gérez vos informations médicales en toute sécurité." styleClass="brand-subtitle" />
                        </VBox>
                        
                        <HBox spacing="25.0">
                            <children>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5.0">
                                    <padding>
                                        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
                                    </padding>
                                    <Label text="GROUPE SANGUIN" styleClass="stat-label" />
                                    <Label fx:id="bloodGroupLabelDisplay" text="A+" styleClass="stat-value" style="-fx-text-fill: #FC8181;" />
                                </VBox>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5.0">
                                    <padding>
                                        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
                                    </padding>
                                    <Label text="POIDS ACTUEL" styleClass="stat-label" />
                                    <HBox alignment="CENTER" spacing="5.0">
                                        <Label fx:id="poidsLabelDisplay" text="75" styleClass="stat-value" />
                                        <Label text="kg" styleClass="stat-label" />
                                    </HBox>
                                </VBox>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5.0">
                                    <padding>
                                        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
                                    </padding>
                                    <Label text="TAILLE" styleClass="stat-label" />
                                    <HBox alignment="CENTER" spacing="5.0">
                                        <Label fx:id="tailleLabelDisplay" text="180" styleClass="stat-value" />
                                        <Label text="cm" styleClass="stat-label" />
                                    </HBox>
                                </VBox>
                            </children>
                        </HBox>
                        
                        <VBox spacing="20.0" styleClass="form-panel">
                            <padding>
                                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                            </padding>
                            <children>
                                <Label text="Dossier Médical Personnalisé" styleClass="form-title" />
                                
                                <GridPane hgap="30.0" vgap="20.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="5.0" GridPane.columnIndex="0">
                                            <Label text="Groupe Sanguin" styleClass="field-label" />
                                            <TextField fx:id="groupeSanguinField" styleClass="field-input" promptText="ex: O+" />
                                            <Label fx:id="errorGroupeSanguin" text="" styleClass="field-error" visible="false" managed="false"/>
                                        </VBox>
                                        <HBox spacing="15.0" GridPane.columnIndex="1">
                                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                <Label text="Poids (kg)" styleClass="field-label" />
                                                <TextField fx:id="poidsField" styleClass="field-input" promptText="0.0" />
                                                <Label fx:id="errorPoids" text="" styleClass="field-error" visible="false" managed="false"/>
                                            </VBox>
                                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                <Label text="Taille (cm)" styleClass="field-label" />
                                                <TextField fx:id="tailleField" styleClass="field-input" promptText="0" />
                                                <Label fx:id="errorTaille" text="" styleClass="field-error" visible="false" managed="false"/>
                                            </VBox>
                                        </HBox>
                                        <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label text="Antécédents Médicaux" styleClass="field-label" />
                                            <TextArea fx:id="antecedentsArea" styleClass="field-input" prefHeight="120.0" wrapText="true" />
                                        </VBox>
                                        <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <Label text="Allergies et Contre-indications" styleClass="field-label" />
                                            <TextArea fx:id="allergiesArea" styleClass="field-input" prefHeight="120.0" wrapText="true" />
                                        </VBox>
                                    </children>
                                </GridPane>
                                
                                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                    <padding>
                                        <Insets top="10.0" />
                                    </padding>
                                    <Label fx:id="successLabel" />
                                    <Button text="Mettre à jour mon dossier" onAction="#handleSaveMedicalRecord" styleClass="btn-primary" prefWidth="250.0" />
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>