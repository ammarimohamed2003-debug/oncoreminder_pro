<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="root-pane bg-dashboard" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.AdminDashboardController">

    <!-- ══════════════ SIDEBAR ══════════════ -->
    <left>
        <VBox spacing="10" styleClass="form-panel" prefWidth="220"
              style="-fx-border-color: #D6CBFF; -fx-border-width: 0 2 0 0;">
            <padding><Insets bottom="24" left="16" right="16" top="24"/></padding>

            <!-- Logo Admin -->
            <VBox alignment="CENTER" spacing="10">
                <StackPane>
                    <Circle radius="40" fill="rgba(43,188,176,0.15)"/>
                    <Circle radius="28" fill="rgba(43,188,176,0.25)"/>
                    <Label text="⚕" style="-fx-font-size: 26px; -fx-text-fill: #2BBCB0;"/>
                </StackPane>
                <Label fx:id="adminNameLabel" text="Admin" styleClass="brand-title"/>
                <Label text="Administrateur" styleClass="brand-subtitle"/>
            </VBox>

            <Separator/>

            <Button text="🏠  Tableau de bord" styleClass="btn-primary"
                    maxWidth="Infinity"/>
            <Button text="👥  Utilisateurs" styleClass="btn-secondary"
                    maxWidth="Infinity"/>
            <Button text="📋  Logs Système" styleClass="btn-secondary"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Stats mini -->
            <VBox spacing="6" style="-fx-padding: 12 8 12 8; -fx-background-color: #F4F0FF;
                                     -fx-background-radius: 10;">
                <Label text="Total Utilisateurs" styleClass="stat-label"/>
                <Label fx:id="totalUsersLabel" text="0" styleClass="stat-value"
                       style="-fx-font-size: 28px;"/>
                <Label text="Inscrits actifs" styleClass="stat-badge-info"/>
            </VBox>

            <Button text="🚪  Déconnexion" onAction="#handleLogout"
                    styleClass="btn-danger" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- ══════════════ CONTENU CENTRAL ══════════════ -->
    <center>
        <VBox spacing="15">
            <padding><Insets bottom="15" left="20" right="20" top="15"/></padding>

            <!-- En-tête -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Administration" styleClass="section-title"
                       style="-fx-font-size: 22px;"/>
                <Label text="OncoReminder Pro"
                       style="-fx-text-fill: #2BBCB0; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Onglets -->
            <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="tab-pane" VBox.vgrow="ALWAYS">
                <tabs>

                    <!-- ════════ ONGLET 1 — ANNUAIRE ════════ -->
                    <Tab text="👥  Annuaire Utilisateurs">
                        <HBox spacing="20">
                            <padding><Insets bottom="10" left="0" right="0" top="12"/></padding>

                            <!-- ── Liste des utilisateurs ── -->
                            <VBox spacing="12" HBox.hgrow="ALWAYS">
                                <TextField fx:id="searchField"
                                           promptText="🔍  Rechercher un utilisateur..."
                                           styleClass="field-input" prefHeight="40"/>
                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                            style="-fx-background-color: transparent;
                                                   -fx-background: transparent;
                                                   -fx-border-color: transparent;">
                                    <FlowPane fx:id="userFlowPane" hgap="14" vgap="14">
                                        <padding><Insets bottom="10" left="5" right="5" top="5"/></padding>
                                    </FlowPane>
                                </ScrollPane>
                            </VBox>

                            <!-- ── Formulaire Actions Utilisateur ── -->
                            <VBox styleClass="form-panel" minWidth="310" prefWidth="330">
                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                            hbarPolicy="NEVER"
                                            style="-fx-background-color: transparent;
                                                   -fx-background: transparent;
                                                   -fx-border-color: transparent;">
                                    <VBox spacing="12">
                                        <padding><Insets bottom="20" left="20" right="20" top="18"/></padding>

                                        <!-- Titre + mode -->
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label text="Actions Utilisateur" styleClass="form-title"/>
                                            <Label fx:id="formModeLabel" text="[Ajout]"
                                                   style="-fx-text-fill: #2BBCB0; -fx-font-size: 11px;
                                                          -fx-font-weight: bold; -fx-padding: 2 8 2 8;
                                                          -fx-background-color: rgba(43,188,176,0.12);
                                                          -fx-background-radius: 10;"/>
                                        </HBox>

                                        <Separator/>

                                        <!-- Nom -->
                                        <VBox spacing="3">
                                            <Label text="Nom *" styleClass="field-label"/>
                                            <TextField fx:id="nomField" styleClass="field-input" prefHeight="38"/>
                                            <Label fx:id="errorNom" text="" styleClass="field-error"
                                                   visible="false" managed="false"/>
                                        </VBox>

                                        <!-- Prénom -->
                                        <VBox spacing="3">
                                            <Label text="Prénom *" styleClass="field-label"/>
                                            <TextField fx:id="prenomField" styleClass="field-input" prefHeight="38"/>
                                            <Label fx:id="errorPrenom" text="" styleClass="field-error"
                                                   visible="false" managed="false"/>
                                        </VBox>

                                        <!-- Email -->
                                        <VBox spacing="3">
                                            <Label text="Email *" styleClass="field-label"/>
                                            <TextField fx:id="emailField" promptText="exemple@domain.com"
                                                       styleClass="field-input" prefHeight="38"/>
                                            <Label fx:id="errorEmail" text="" styleClass="field-error"
                                                   visible="false" managed="false"/>
                                        </VBox>

                                        <!-- Rôle -->
                                        <VBox spacing="3">
                                            <Label text="Rôle *" styleClass="field-label"/>
                                            <ComboBox fx:id="roleCombo" styleClass="field-combo"
                                                      maxWidth="Infinity" prefHeight="38"/>
                                        </VBox>

                                        <Separator/>

                                        <!-- Hint mot de passe (modification) -->
                                        <Label fx:id="passwordHintLabel"
                                               text="ℹ️  Laissez vide pour conserver le mot de passe actuel."
                                               wrapText="true" visible="false" managed="false"
                                               style="-fx-text-fill: #888; -fx-font-size: 11px;
                                                      -fx-font-style: italic; -fx-padding: 0;"/>

                                        <!-- Mot de passe -->
                                        <VBox spacing="3">
                                            <HBox alignment="CENTER_LEFT" spacing="6">
                                                <Label fx:id="pwdLabel" text="Mot de passe *"
                                                       styleClass="field-label"/>
                                            </HBox>
                                            <StackPane>
                                                <PasswordField fx:id="passwordField"
                                                               promptText="Minimum 8 caractères"
                                                               styleClass="field-input" prefHeight="38"/>
                                                <TextField fx:id="passwordVisible"
                                                           promptText="Minimum 8 caractères"
                                                           styleClass="field-input" prefHeight="38"
                                                           visible="false" managed="false"/>
                                            </StackPane>
                                            <Label fx:id="errorPassword" text="" styleClass="field-error"
                                                   visible="false" managed="false"/>
                                        </VBox>

                                        <!-- Confirmation mot de passe -->
                                        <VBox spacing="3">
                                            <Label fx:id="confirmLabel" text="Confirmer le mot de passe *"
                                                   styleClass="field-label"/>
                                            <StackPane>
                                                <PasswordField fx:id="confirmField"
                                                               promptText="Répétez le mot de passe"
                                                               styleClass="field-input" prefHeight="38"/>
                                                <TextField fx:id="confirmVisible"
                                                           promptText="Répétez le mot de passe"
                                                           styleClass="field-input" prefHeight="38"
                                                           visible="false" managed="false"/>
                                            </StackPane>
                                            <Label fx:id="errorConfirm" text="" styleClass="field-error"
                                                   visible="false" managed="false"/>
                                        </VBox>

                                        <!-- Toggle show/hide -->
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <CheckBox fx:id="showPwdCheck" onAction="#toggleShowPassword"/>
                                            <Label text="Afficher le mot de passe"
                                                   style="-fx-text-fill: #666; -fx-font-size: 11px;"/>
                                        </HBox>

                                        <!-- Feedback message -->
                                        <Label fx:id="feedbackLabel" text="" wrapText="true"
                                               visible="false" managed="false"
                                               style="-fx-font-size: 12px; -fx-font-weight: bold;
                                                      -fx-padding: 8 12 8 12; -fx-background-radius: 6;
                                                      -fx-border-radius: 6; -fx-border-width: 1;"/>

                                        <!-- Boutons -->
                                        <HBox spacing="8">
                                            <Button text="➕  Ajouter" onAction="#handleAddUser"
                                                    styleClass="btn-primary"
                                                    HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="38"/>
                                            <Button text="✏️  Modifier" onAction="#handleUpdateUser"
                                                    styleClass="btn-warning"
                                                    HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="38"/>
                                        </HBox>
                                        <HBox spacing="8">
                                            <Button text="🗑  Supprimer" onAction="#handleDeleteUser"
                                                    styleClass="btn-danger"
                                                    HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36"/>
                                            <Button text="✕  Effacer" onAction="#handleClearForm"
                                                    styleClass="btn-secondary"
                                                    HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="36"/>
                                        </HBox>

                                    </VBox>
                                </ScrollPane>
                            </VBox>
                        </HBox>
                    </Tab>

                    <!-- ════════ ONGLET 2 — LOGS ════════ -->
                    <Tab text="📋  Historique d'accès">
                        <VBox spacing="15">
                            <padding><Insets bottom="10" left="0" right="0" top="12"/></padding>
                            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                        style="-fx-background-color: transparent;
                                               -fx-background: transparent;
                                               -fx-border-color: transparent;">
                                <VBox fx:id="logContainer" spacing="8">
                                    <padding><Insets bottom="10" left="5" right="5" top="5"/></padding>
                                </VBox>
                            </ScrollPane>
                        </VBox>
                    </Tab>

                </tabs>
            </TabPane>
        </VBox>
    </center>

</BorderPane>
