<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="root-pane bg-dashboard" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.oncoreminder.controllers.AdminDashboardController">
    <left>
        <VBox spacing="10.0" styleClass="form-panel" prefWidth="250.0">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="10.0">
                    <StackPane>
                        <Circle radius="40.0" fill="rgba(43,188,176,0.15)"/>
                        <Circle radius="28.0" fill="rgba(43,188,176,0.25)"/>
                        <Label text="⚕" style="-fx-font-size: 28px; -fx-text-fill: #2BBCB0;"/>
                    </StackPane>
                    <Label fx:id="adminNameLabel" text="Admin" styleClass="brand-title" />
                    <Label text="Administrateur" styleClass="brand-subtitle" />
                </VBox>
                <Separator />
                <Button text="Tableau de bord" styleClass="btn-primary" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button text="Utilisateurs" styleClass="btn-secondary" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button text="Logs Système" styleClass="btn-secondary" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Region VBox.vgrow="ALWAYS" />
                <Button text="Déconnexion" onAction="#handleLogout" styleClass="btn-danger" maxWidth="Infinity" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <HBox spacing="20.0">
                    <children>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                            </padding>
                            <children>
                                <Label text="Total Utilisateurs" styleClass="stat-label" />
                                <Label fx:id="totalUsersLabel" text="0" styleClass="stat-value" />
                                <Label text="Mise à jour réelle" styleClass="stat-badge-success" />
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                            </padding>
                            <children>
                                <Label text="Statut Serveur" styleClass="stat-label" />
                                <Label text="ONLINE" styleClass="stat-value" style="-fx-text-fill: #38A169;" />
                                <Label text="Latence: 12ms" styleClass="stat-badge-info" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                
                <TabPane side="TOP" tabClosingPolicy="UNAVAILABLE" styleClass="tab-pane" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Annuaire Utilisateurs">
                            <HBox spacing="20.0">
                                <padding>
                                    <Insets bottom="10.0" left="0.0" right="0.0" top="10.0" />
                                </padding>
                                <children>
                                    <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                        <TextField fx:id="searchField" promptText="Rechercher un utilisateur..." styleClass="field-input" />
                                        <ScrollPane fitToWidth="true" styleClass="stat-scroll-pane" VBox.vgrow="ALWAYS">
                                            <content>
                                                <FlowPane fx:id="userFlowPane" hgap="15.0" vgap="15.0" prefWrapLength="600.0">
                                                    <padding>
                                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                                    </padding>
                                                </FlowPane>
                                            </content>
                                        </ScrollPane>
                                    </VBox>
                                    <VBox spacing="15.0" styleClass="form-panel" minWidth="320.0">
                                        <padding>
                                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                        </padding>
                                        <children>
                                            <Label text="Actions Utilisateur" styleClass="form-title" />
                                            <VBox spacing="5.0">
                                                <Label text="Nom" styleClass="field-label" />
                                                <TextField fx:id="nomField" styleClass="field-input" />
                                            </VBox>
                                            <VBox spacing="5.0">
                                                <Label text="Prénom" styleClass="field-label" />
                                                <TextField fx:id="prenomField" styleClass="field-input" />
                                            </VBox>
                                            <VBox spacing="5.0">
                                                <Label text="Email" styleClass="field-label" />
                                                <TextField fx:id="emailField" styleClass="field-input" />
                                            </VBox>
                                            <VBox spacing="5.0">
                                                <Label text="Rôle" styleClass="field-label" />
                                                <ComboBox fx:id="roleCombo" styleClass="field-combo" maxWidth="Infinity" />
                                            </VBox>
                                            <Region VBox.vgrow="ALWAYS" />
                                            <HBox spacing="10.0">
                                                <Button text="Ajouter" onAction="#handleAddUser" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                                <Button text="Modifier" onAction="#handleUpdateUser" styleClass="btn-warning" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                            </HBox>
                                            <Button text="Supprimer" onAction="#handleDeleteUser" styleClass="btn-danger" maxWidth="Infinity" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                        </Tab>
                        <Tab text="Historique d'accès">
                            <VBox spacing="15.0">
                                <padding>
                                    <Insets bottom="10.0" left="0.0" right="0.0" top="10.0" />
                                </padding>
                                <children>
                                    <ScrollPane fitToWidth="true" styleClass="stat-scroll-pane" VBox.vgrow="ALWAYS">
                                        <content>
                                            <VBox fx:id="logContainer" spacing="10.0">
                                                <padding>
                                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                                </padding>
                                            </VBox>
                                        </content>
                                    </ScrollPane>
                                </children>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </center>
</BorderPane>
