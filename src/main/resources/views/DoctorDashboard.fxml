<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="root-pane bg-dashboard" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.DoctorDashboardController">

    <!-- ── Sidebar médecin (partagée) ── -->
    <left>
        <fx:include fx:id="doctorSidebar" source="DoctorSidebar.fxml"/>
    </left>

    <!-- ══════════════ CONTENU ══════════════ -->
    <center>
        <StackPane>
        <VBox fx:id="mainContent" spacing="0">

            <!-- Top bar -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT">
                <padding><Insets bottom="12" left="20" right="20" top="12"/></padding>
                <Label text="Espace Médecin" styleClass="brand-subtitle"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A2D8F;"/>
            </HBox>

            <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="tab-pane" VBox.vgrow="ALWAYS">
            <tabs>

            <!-- ════ ONGLET 1 — MON PROFIL ════ -->
            <Tab text="👨‍⚕️  Mon Profil">
                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: #F5F7FF; -fx-background: #F5F7FF;
                                   -fx-border-color: transparent;">
                    <VBox spacing="24">
                        <padding><Insets bottom="40" left="40" right="40" top="28"/></padding>

                        <Label text="Mon Profil Médecin" styleClass="section-title"
                               style="-fx-font-size: 20px;"/>

                        <!-- Informations personnelles -->
                        <VBox spacing="18" styleClass="form-panel">
                            <padding><Insets bottom="28" left="28" right="28" top="24"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="👤" style="-fx-font-size: 18px;"/>
                                <Label text="Informations Personnelles" styleClass="form-title"/>
                            </HBox>
                            <Separator/>

                            <HBox spacing="16">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Nom" styleClass="field-label"/>
                                    <TextField fx:id="docNomField" styleClass="field-input" prefHeight="40"/>
                                    <Label fx:id="docErrorNom" text="" styleClass="field-error"
                                           visible="false" managed="false"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Prénom" styleClass="field-label"/>
                                    <TextField fx:id="docPrenomField" styleClass="field-input" prefHeight="40"/>
                                    <Label fx:id="docErrorPrenom" text="" styleClass="field-error"
                                           visible="false" managed="false"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="4">
                                <Label text="Email" styleClass="field-label"/>
                                <TextField fx:id="docEmailField" styleClass="field-input" prefHeight="40"/>
                                <Label fx:id="docErrorEmail" text="" styleClass="field-error"
                                       visible="false" managed="false"/>
                            </VBox>

                            <HBox spacing="16">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Téléphone" styleClass="field-label"/>
                                    <TextField fx:id="docTelField" promptText="+213 XX XX XX XX"
                                               styleClass="field-input" prefHeight="40"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Sexe" styleClass="field-label"/>
                                    <ComboBox fx:id="docSexeCombo" styleClass="field-combo"
                                              maxWidth="Infinity" prefHeight="40"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="4">
                                <Label text="Date de naissance (JJ/MM/AAAA)" styleClass="field-label"/>
                                <TextField fx:id="docDateNaissField" promptText="ex: 15/03/1985"
                                           styleClass="field-input" prefHeight="40"/>
                            </VBox>
                        </VBox>

                        <!-- Informations professionnelles -->
                        <VBox spacing="18" styleClass="form-panel">
                            <padding><Insets bottom="28" left="28" right="28" top="24"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🏥" style="-fx-font-size: 18px;"/>
                                <Label text="Informations Professionnelles" styleClass="form-title"/>
                            </HBox>
                            <Separator/>

                            <HBox spacing="16">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Spécialité" styleClass="field-label"/>
                                    <ComboBox fx:id="docSpecialiteCombo" styleClass="field-combo"
                                              maxWidth="Infinity" prefHeight="40"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="N° Matricule / RPPS" styleClass="field-label"/>
                                    <TextField fx:id="docMatriculeField" promptText="ex: 10012345678"
                                               styleClass="field-input" prefHeight="40"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="4">
                                <Label text="Hôpital / Clinique" styleClass="field-label"/>
                                <TextField fx:id="docHopitalField" promptText="Nom de l'établissement"
                                           styleClass="field-input" prefHeight="40"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Adresse professionnelle" styleClass="field-label"/>
                                <TextField fx:id="docAdresseField"
                                           promptText="N° Rue, Ville, Code postal"
                                           styleClass="field-input" prefHeight="40"/>
                            </VBox>
                        </VBox>

                        <!-- Feedback -->
                        <Label fx:id="docProfileFeedback" text="" wrapText="true"
                               visible="false" managed="false"
                               style="-fx-font-size: 12px; -fx-font-weight: bold;
                                      -fx-padding: 8 12 8 12; -fx-background-radius: 6;
                                      -fx-border-radius: 6; -fx-border-width: 1;"/>

                        <HBox alignment="CENTER_RIGHT" spacing="12">
                            <Button text="✕  Annuler" onAction="#handleCancelDocProfile"
                                    styleClass="btn-secondary" prefHeight="40" prefWidth="120"/>
                            <Button fx:id="saveDocProfileBtn" text="💾  Enregistrer le profil"
                                    onAction="#handleSaveDocProfile"
                                    styleClass="btn-primary" prefHeight="40" prefWidth="240"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ════ ONGLET 3 — SÉCURITÉ ════ -->
            <Tab text="🔐  Sécurité">
                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: #F5F7FF; -fx-background: #F5F7FF;
                                   -fx-border-color: transparent;">
                    <VBox spacing="24">
                        <padding><Insets bottom="40" left="40" right="40" top="28"/></padding>

                        <VBox spacing="18" styleClass="form-panel" maxWidth="560">
                            <padding><Insets bottom="28" left="28" right="28" top="24"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🔐" style="-fx-font-size: 18px;"/>
                                <Label text="Modifier le mot de passe" styleClass="form-title"/>
                            </HBox>
                            <Separator/>

                            <Label text="Pour modifier votre mot de passe, entrez d'abord votre mot de passe actuel."
                                   wrapText="true"
                                   style="-fx-text-fill: #888; -fx-font-size: 12px;"/>

                            <VBox spacing="4">
                                <Label text="Mot de passe actuel" styleClass="field-label"/>
                                <StackPane>
                                    <PasswordField fx:id="docOldPwdField"
                                                   promptText="Votre mot de passe actuel"
                                                   styleClass="field-input" prefHeight="42"/>
                                    <TextField fx:id="docOldPwdVisible" promptText="Votre mot de passe actuel"
                                               styleClass="field-input" prefHeight="42"
                                               visible="false" managed="false"/>
                                </StackPane>
                                <Label fx:id="docErrorOldPwd" text="" styleClass="field-error"
                                       visible="false" managed="false"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Nouveau mot de passe" styleClass="field-label"/>
                                <StackPane>
                                    <PasswordField fx:id="docNewPwdField" promptText="Minimum 8 caractères"
                                                   styleClass="field-input" prefHeight="42"/>
                                    <TextField fx:id="docNewPwdVisible" promptText="Minimum 8 caractères"
                                               styleClass="field-input" prefHeight="42"
                                               visible="false" managed="false"/>
                                </StackPane>
                                <Label fx:id="docErrorNewPwd" text="" styleClass="field-error"
                                       visible="false" managed="false"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Confirmer le nouveau mot de passe" styleClass="field-label"/>
                                <StackPane>
                                    <PasswordField fx:id="docConfirmPwdField"
                                                   promptText="Répétez le nouveau mot de passe"
                                                   styleClass="field-input" prefHeight="42"/>
                                    <TextField fx:id="docConfirmPwdVisible"
                                               promptText="Répétez le nouveau mot de passe"
                                               styleClass="field-input" prefHeight="42"
                                               visible="false" managed="false"/>
                                </StackPane>
                                <Label fx:id="docErrorConfirmPwd" text="" styleClass="field-error"
                                       visible="false" managed="false"/>
                            </VBox>

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <CheckBox fx:id="docShowPwdCheck" onAction="#toggleDocShowPassword"/>
                                <Label text="Afficher les mots de passe"
                                       style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                            </HBox>

                            <Label fx:id="docPwdFeedback" text="" wrapText="true"
                                   visible="false" managed="false"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-padding: 8 12 8 12; -fx-background-radius: 6;
                                          -fx-border-radius: 6; -fx-border-width: 1;"/>

                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <Button text="✕  Annuler" onAction="#handleCancelDocPassword"
                                        styleClass="btn-secondary" prefHeight="40" prefWidth="120"/>
                                <Button fx:id="saveDocPwdBtn" text="🔐  Changer le mot de passe"
                                        onAction="#handleChangeDocPassword"
                                        styleClass="btn-primary" prefHeight="40" prefWidth="240"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            </tabs>
        </TabPane>
        </VBox>

        <VBox fx:id="eventsPane" visible="false" managed="false">
            <fx:include fx:id="eventTabContent" source="EventTabContent.fxml" VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox fx:id="reservationsPane" visible="false" managed="false">
            <fx:include fx:id="reservationContent" source="ReservationContent.fxml" VBox.vgrow="ALWAYS"/>
        </VBox>
        </StackPane>
    </center>

</BorderPane>
