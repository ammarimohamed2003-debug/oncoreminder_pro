<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="root-pane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.oncoreminder.controllers.DoctorDashboardController">
    <top>
        <HBox spacing="20.0" styleClass="topbar" alignment="CENTER_LEFT">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <VBox>
                    <Label text="OncoReminder Pro" styleClass="brand-title" />
                    <Label text="Espace Médical" styleClass="brand-subtitle" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="15.0" alignment="CENTER">
                    <Button text="📰 Articles" onAction="#handleArticles" styleClass="btn-primary" prefWidth="120"/>
                    <Label fx:id="doctorNameLabel" text="Dr. Chargement..." styleClass="stat-label" />
                    <Button text="Déconnexion" onAction="#handleLogout" styleClass="btn-outline" />
                </HBox>
            </children>
        </HBox>
    </top>
    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <Label text="Mes Patients" styleClass="section-title" />
                    <ScrollPane fitToWidth="true" styleClass="stat-scroll-pane" VBox.vgrow="ALWAYS">
                        <content>
                            <FlowPane fx:id="patientFlowPane" hgap="15.0" vgap="15.0">
                                <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                </padding>
                            </FlowPane>
                        </content>
                    </ScrollPane>
                </VBox>
                <VBox styleClass="form-panel" minWidth="320.0" prefWidth="340.0">
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox spacing="12">
                            <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>
                            <Label text="Dossier Patient" styleClass="form-title" />
                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                                <Circle radius="25.0" fill="#2BBCB0" opacity="0.1" />
                                <Label fx:id="selectedPatientLabel" text="Sélectionnez un patient" styleClass="brand-title" wrapText="true"/>
                            </HBox>
                            <Separator />
                            <GridPane hgap="10.0" vgap="10.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                                </columnConstraints>
                                <children>
                                    <VBox styleClass="stat-card" alignment="CENTER" GridPane.columnIndex="0">
                                        <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>
                                        <Label text="SANG" styleClass="stat-label" />
                                        <Label fx:id="bloodGroupLabel" text="--" styleClass="stat-value" />
                                    </VBox>
                                    <VBox styleClass="stat-card" alignment="CENTER" GridPane.columnIndex="1">
                                        <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>
                                        <Label text="POIDS" styleClass="stat-label" />
                                        <Label fx:id="weightLabel" text="--" styleClass="stat-value" />
                                    </VBox>
                                    <VBox styleClass="stat-card" alignment="CENTER" GridPane.columnIndex="2">
                                        <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>
                                        <Label text="TAILLE" styleClass="stat-label" />
                                        <Label fx:id="heightLabel" text="--" styleClass="stat-value" />
                                    </VBox>
                                </children>
                            </GridPane>
                            <VBox spacing="5.0">
                                <Label text="Antécédents" styleClass="field-label" />
                                <TextArea fx:id="antecedentsArea" styleClass="field-input" editable="false" wrapText="true" prefHeight="100.0" />
                            </VBox>
                            <VBox spacing="5.0">
                                <Label text="Allergies" styleClass="field-label" />
                                <TextArea fx:id="allergiesArea" styleClass="field-input" editable="false" wrapText="true" prefHeight="100.0" />
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>