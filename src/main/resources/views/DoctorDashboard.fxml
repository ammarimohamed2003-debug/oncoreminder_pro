<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="root-pane bg-dashboard" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.DoctorDashboardController">

    <!-- ── Sidebar médecin ── -->
    <left>
        <VBox prefWidth="255" styleClass="doctor-sidebar">

            <!-- Branding -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-padding: 18 18 15 18;
                         -fx-border-color: transparent transparent rgba(255,255,255,0.10) transparent;
                         -fx-border-width: 0 0 1 0;">
                <StackPane>
                    <Circle radius="17" fill="#2BBCB0" opacity="0.22"/>
                    <Label text="⚕" style="-fx-font-size: 14px; -fx-text-fill: #2BBCB0;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="OncoReminder" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label text="Pro" style="-fx-text-fill: #2BBCB0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Avatar médecin -->
            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 20 16 16 16;">
                <StackPane>
                    <Circle radius="44" fill="#2BBCB0" opacity="0.12"/>
                    <Circle radius="38" fill="#1A3452"/>
                    <Circle radius="33" fill="#2A5080"/>
                    <Label text="🩺" style="-fx-font-size: 26px;"/>
                </StackPane>
                <Label fx:id="doctorNameLabel" text="Dr. Chargement..."
                       style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"
                       wrapText="true" maxWidth="210" textAlignment="CENTER"/>
                <Label text="Médecin"
                       style="-fx-background-color: rgba(43,188,176,0.20); -fx-text-fill: #2BBCB0;
                              -fx-background-radius: 20; -fx-padding: 3 14; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Divider -->
            <Pane prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.10);">
                <VBox.margin><Insets left="18" right="18" bottom="6"/></VBox.margin>
            </Pane>

            <!-- Navigation -->
            <VBox spacing="2" style="-fx-padding: 10 10 0 10;">
                <Label text="NAVIGATION"
                       style="-fx-text-fill: rgba(255,255,255,0.32); -fx-font-size: 10px;
                              -fx-font-weight: bold; -fx-padding: 0 8 5 8;"/>
                <Button text="🏠  Mon Espace"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn-doctor-active"/>
                <Button text="📰  Mes Articles" onAction="#handleArticles"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button text="👥  Mes Patients"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button text="📅  Rendez-vous"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button text="⚙️  Paramètres"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Divider avant logout -->
            <Pane prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.10);">
                <VBox.margin><Insets left="18" right="18" top="6"/></VBox.margin>
            </Pane>

            <!-- Logout -->
            <VBox style="-fx-padding: 8 10 18 10;">
                <Button text="🔓  Déconnexion" onAction="#handleLogout"
                        maxWidth="Infinity" styleClass="sidebar-logout-btn"/>
            </VBox>

        </VBox>
    </left>

    <!-- ── Centre : patients + dossier ── -->
    <center>
        <VBox spacing="0">

            <!-- Mini topbar interne -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: white;
                         -fx-border-color: transparent transparent #EDE9F8 transparent;
                         -fx-border-width: 0 0 1 0;
                         -fx-effect: dropshadow(gaussian, rgba(91,53,165,0.08), 8, 0, 0, 2);
                         -fx-padding: 12 24;">
                <Label text="🏠 Tableau de bord" styleClass="brand-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Gérez vos patients et vos articles médicaux."
                       style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Contenu principal -->
            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

                <!-- Colonne gauche : liste patients -->
                <VBox spacing="15" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="👥 Mes Patients" styleClass="section-title"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" styleClass="stat-scroll-pane" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="patientFlowPane" hgap="15" vgap="15">
                            <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                        </FlowPane>
                    </ScrollPane>
                </VBox>

                <!-- Colonne droite : dossier patient sélectionné -->
                <VBox styleClass="form-panel" minWidth="320" prefWidth="340">
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox spacing="12">
                            <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>
                            <Label text="Dossier Patient" styleClass="form-title"/>
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Circle radius="25" fill="#2BBCB0" opacity="0.1"/>
                                <Label fx:id="selectedPatientLabel" text="Sélectionnez un patient"
                                       styleClass="brand-title" wrapText="true"/>
                            </HBox>
                            <Separator/>
                            <GridPane hgap="10" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10"/>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10"/>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10"/>
                                </columnConstraints>
                                <VBox styleClass="stat-card" alignment="CENTER" GridPane.columnIndex="0">
                                    <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>
                                    <Label text="SANG" styleClass="stat-label"/>
                                    <Label fx:id="bloodGroupLabel" text="--" styleClass="stat-value"/>
                                </VBox>
                                <VBox styleClass="stat-card" alignment="CENTER" GridPane.columnIndex="1">
                                    <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>
                                    <Label text="POIDS" styleClass="stat-label"/>
                                    <Label fx:id="weightLabel" text="--" styleClass="stat-value"/>
                                </VBox>
                                <VBox styleClass="stat-card" alignment="CENTER" GridPane.columnIndex="2">
                                    <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>
                                    <Label text="TAILLE" styleClass="stat-label"/>
                                    <Label fx:id="heightLabel" text="--" styleClass="stat-value"/>
                                </VBox>
                            </GridPane>
                            <VBox spacing="5">
                                <Label text="Antécédents" styleClass="field-label"/>
                                <TextArea fx:id="antecedentsArea" styleClass="field-input"
                                          editable="false" wrapText="true" prefHeight="100"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Allergies" styleClass="field-label"/>
                                <TextArea fx:id="allergiesArea" styleClass="field-input"
                                          editable="false" wrapText="true" prefHeight="100"/>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>
