<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="root-pane bg-articles" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.PatientArticleListController">

    <!-- ── Sidebar patient (partagée) ── -->
    <left>
        <fx:include fx:id="patientSidebar" source="PatientSidebar.fxml"/>
    </left>

    <!-- ── Centre : grille OU détail ── -->
    <center>
        <StackPane>

            <!-- ══ VUE GRILLE ══ -->
            <VBox fx:id="gridView" spacing="0">

                <!-- Barre du haut -->
                <HBox spacing="16" styleClass="topbar" alignment="CENTER_LEFT">
                    <padding><Insets bottom="12" left="20" right="20" top="12"/></padding>
                    <Label text="📰 Articles Médicaux" styleClass="brand-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchField" promptText="🔍 Rechercher un article..."
                               styleClass="field-input" prefWidth="280"/>
                </HBox>

                <!-- Grille scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: #F7F4FE; -fx-background: #F7F4FE;">
                    <FlowPane fx:id="articleFlowPane" hgap="20" vgap="20" alignment="TOP_LEFT"
                              style="-fx-background-color: transparent;">
                        <padding><Insets bottom="24" left="24" right="24" top="24"/></padding>
                    </FlowPane>
                </ScrollPane>

                <!-- Barre de pagination -->
                <HBox fx:id="paginationBar" spacing="8" alignment="CENTER"
                      style="-fx-background-color: white;
                             -fx-border-color: #DDD6F8;
                             -fx-border-width: 1 0 0 0;
                             -fx-effect: dropshadow(gaussian, rgba(90,53,165,0.08), 6, 0, 0, -2);
                             -fx-padding: 8 24;"/>
            </VBox>

            <!-- ══ VUE DÉTAIL ══ -->
            <VBox fx:id="detailView" spacing="0" visible="false" managed="false">

                <!-- Topbar: retour + titre + badge -->
                <HBox spacing="14" styleClass="topbar" alignment="CENTER_LEFT">
                    <padding><Insets bottom="12" left="20" right="20" top="12"/></padding>
                    <Button text="← Retour" onAction="#handleBack"
                            styleClass="btn-outline" prefHeight="36" minWidth="100"
                            style="-fx-padding: 0 16;"/>
                    <Label fx:id="articleTitreLabel" text="" styleClass="brand-subtitle"
                           wrapText="false" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label fx:id="statutBadge" text="Publié" styleClass="stat-badge-success"/>
                </HBox>

                <!-- Contenu scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: #F7F4FE; -fx-background: #F7F4FE;">
                    <VBox spacing="0" style="-fx-background-color: #F7F4FE;">

                        <!-- ── Image hero plein-écran ── -->
                        <StackPane fx:id="imageContainer" prefHeight="320"
                                   visible="false" managed="false"
                                   style="-fx-background-color: #12002E;">
                            <ImageView fx:id="detailImageView"
                                       fitWidth="1600" fitHeight="320"
                                       preserveRatio="true" smooth="true"/>
                        </StackPane>

                        <!-- ── Zone principale ── -->
                        <VBox spacing="18" style="-fx-background-color: #F7F4FE;">
                            <padding><Insets top="22" right="28" bottom="40" left="28"/></padding>

                            <!-- Carte métadonnées -->
                            <HBox spacing="14" alignment="CENTER_LEFT"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 12;
                                         -fx-border-width: 1;
                                         -fx-padding: 14 18;">
                                <Label fx:id="organeLabel" text=""
                                       style="-fx-background-color: #EEF2FF; -fx-text-fill: #5B35A5;
                                              -fx-background-radius: 20; -fx-font-size: 12px;
                                              -fx-font-weight: bold; -fx-padding: 4 12;"/>
                                <Label fx:id="medecinLabel" text=""
                                       style="-fx-background-color: rgba(43,188,176,0.12); -fx-text-fill: #2BBCB0;
                                              -fx-background-radius: 20; -fx-font-size: 12px;
                                              -fx-font-weight: bold; -fx-padding: 4 12;"
                                       visible="false" managed="false"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="dateLabel"  text="" styleClass="stat-label"/>
                                <Label text="|" style="-fx-text-fill: #D1C4E9;"/>
                                <Label fx:id="viewsLabel" text="" styleClass="stat-label"/>
                                <Label fx:id="tagsLabel"  text="" styleClass="stat-label"
                                       visible="false" managed="false"/>
                            </HBox>

                            <!-- Carte contenu -->
                            <VBox style="-fx-background-color: white;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-padding: 26;">
                                <VBox fx:id="contenuContainer" spacing="6" minHeight="80"/>
                            </VBox>

                            <!-- Barre like + export -->
                            <HBox spacing="12" alignment="CENTER_LEFT"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 12;
                                         -fx-border-width: 1;
                                         -fx-padding: 12 18;">
                                <Button fx:id="likeBtn" text="❤  J'aime" onAction="#handleLike"
                                        styleClass="btn-outline" prefHeight="38" minWidth="130"
                                        style="-fx-padding: 0 20; -fx-font-size: 13px;"/>
                                <Label fx:id="likesLabel" text="0 likes" styleClass="stat-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="📄  Exporter PDF" onAction="#handleExportPdf"
                                        styleClass="btn-outline" prefHeight="38" minWidth="150"
                                        style="-fx-padding: 0 16; -fx-font-size: 13px;
                                               -fx-text-fill: #5B35A5; -fx-border-color: #D1C4E9;"/>
                            </HBox>

                            <!-- Évaluation article -->
                            <VBox fx:id="evalSection" spacing="10" visible="false" managed="false"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-padding: 18 22;">
                                <Label fx:id="evalTitre" text="⭐  Évaluez cet article"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3A1D7A;"/>
                                <Separator style="-fx-background-color: #EDE9F8;"/>
                                <HBox fx:id="evalStarsBox" spacing="6" alignment="CENTER_LEFT"/>
                                <Label fx:id="evalMessage" text="" wrapText="true"
                                       visible="false" managed="false"
                                       style="-fx-text-fill: #5B35A5; -fx-font-size: 12px; -fx-font-style: italic;"/>
                            </VBox>

                            <!-- Carte commentaires -->
                            <VBox spacing="14"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-padding: 22;">
                                <Label text="💬 Commentaires"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3A1D7A;"/>
                                <Separator style="-fx-background-color: #EDE9F8;"/>
                                <VBox fx:id="commentsContainer" spacing="10" minHeight="40"/>
                                <VBox spacing="6">
                                    <HBox alignment="CENTER_RIGHT">
                                        <Button fx:id="emojiBtn" text="😊  Émojis" onAction="#handleEmojiPicker"
                                                style="-fx-background-color: #F3F0FF; -fx-text-fill: #5B35A5;
                                                       -fx-background-radius: 8; -fx-border-width: 0;
                                                       -fx-font-family: 'Segoe UI Emoji';
                                                       -fx-padding: 5 12; -fx-font-size: 12px; -fx-cursor: hand;"/>
                                    </HBox>
                                    <HBox spacing="12" alignment="CENTER">
                                        <TextArea fx:id="commentField" promptText="Votre commentaire..."
                                                  styleClass="field-input" HBox.hgrow="ALWAYS"
                                                  prefHeight="72" wrapText="true"/>
                                        <Button text="Envoyer →" onAction="#handleAddComment"
                                                styleClass="btn-primary" minWidth="120" prefHeight="72"
                                                style="-fx-padding: 0 18; -fx-font-size: 13px;"/>
                                    </HBox>
                                </VBox>
                            </VBox>

                        </VBox>
                    </VBox>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
