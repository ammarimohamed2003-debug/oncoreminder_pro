<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="root-pane bg-articles" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.PatientArticleListController">

    <!-- ── Sidebar patient (partagée) ── -->
    <left>
        <fx:include fx:id="patientSidebar" source="PatientSidebar.fxml"/>
    </left>

    <!-- ── Centre : grille OU détail ── -->
    <center>
        <StackPane>

            <!-- ══ VUE GRILLE ══ -->
            <VBox fx:id="gridView" spacing="0">

                <!-- Barre du haut -->
                <HBox spacing="16" styleClass="topbar" alignment="CENTER_LEFT">
                    <padding><Insets bottom="12" left="20" right="20" top="12"/></padding>
                    <Label text="📰 Articles Médicaux" styleClass="brand-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchField" promptText="🔍 Rechercher un article..."
                               styleClass="field-input" prefWidth="260"/>
                </HBox>

                <!-- Barre de filtres par organe -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-background-color:white;-fx-border-color:#EDE9F8;-fx-border-width:0 0 1 0;-fx-padding:0 20;">
                    <Label text="Filtrer : " style="-fx-font-size:11px;-fx-text-fill:#94A3B8;-fx-padding:0 8 0 0;"/>
                    <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true" prefHeight="42"
                                style="-fx-background-color:transparent;-fx-background:transparent;-fx-border-color:transparent;">
                        <HBox fx:id="filterBar" spacing="6" alignment="CENTER_LEFT"
                              style="-fx-padding:8 0 8 0;"/>
                    </ScrollPane>
                </HBox>

                <!-- Grille scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: #F7F4FE; -fx-background: #F7F4FE;">
                    <VBox style="-fx-background-color:#F7F4FE;">
                        <!-- Compteur résultats -->
                        <HBox style="-fx-padding:14 24 4 24;">
                            <Label fx:id="resultCountLabel" text=""
                                   style="-fx-font-size:11px;-fx-text-fill:#94A3B8;"/>
                        </HBox>
                        <FlowPane fx:id="articleFlowPane" hgap="20" vgap="20" alignment="TOP_LEFT"
                                  style="-fx-background-color: transparent;">
                            <padding><Insets bottom="24" left="24" right="24" top="8"/></padding>
                        </FlowPane>
                    </VBox>
                </ScrollPane>

                <!-- Barre de pagination -->
                <HBox fx:id="paginationBar" spacing="8" alignment="CENTER"
                      style="-fx-background-color: white;
                             -fx-border-color: #DDD6F8;
                             -fx-border-width: 1 0 0 0;
                             -fx-effect: dropshadow(gaussian, rgba(90,53,165,0.08), 6, 0, 0, -2);
                             -fx-padding: 8 24;"/>
            </VBox>

            <!-- ══ VUE DÉTAIL ══ -->
            <VBox fx:id="detailView" spacing="0" visible="false" managed="false">

                <!-- Topbar: retour + titre + badges -->
                <HBox spacing="14" styleClass="topbar" alignment="CENTER_LEFT">
                    <padding><Insets bottom="12" left="20" right="20" top="12"/></padding>
                    <Button text="← Retour" onAction="#handleBack"
                            styleClass="btn-outline" prefHeight="36" minWidth="90"
                            style="-fx-padding: 0 14;"/>
                    <Label fx:id="articleTitreLabel" text="" styleClass="brand-subtitle"
                           wrapText="false" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label fx:id="readTimeLabel" text=""
                           style="-fx-font-size:11px;-fx-text-fill:#6B7280;-fx-background-color:#F1F5F9;-fx-background-radius:10;-fx-padding:3 10;"/>
                    <Label fx:id="statutBadge" text="Publié" styleClass="stat-badge-success"/>
                </HBox>

                <!-- Contenu scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: #F7F4FE; -fx-background: #F7F4FE;">
                    <VBox spacing="0" style="-fx-background-color: #F7F4FE;">

                        <!-- ── Image hero plein-écran ── -->
                        <StackPane fx:id="imageContainer" prefHeight="320"
                                   visible="false" managed="false"
                                   style="-fx-background-color: #12002E;">
                            <ImageView fx:id="detailImageView"
                                       fitWidth="1600" fitHeight="320"
                                       preserveRatio="true" smooth="true"/>
                        </StackPane>

                        <!-- ── Zone principale ── -->
                        <VBox spacing="18" style="-fx-background-color: #F7F4FE;">
                            <padding><Insets top="22" right="28" bottom="40" left="28"/></padding>

                            <!-- Carte métadonnées -->
                            <HBox spacing="14" alignment="CENTER_LEFT"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 12;
                                         -fx-border-width: 1;
                                         -fx-padding: 14 18;">
                                <Label fx:id="organeLabel" text=""
                                       style="-fx-background-color: #EEF2FF; -fx-text-fill: #5B35A5;
                                              -fx-background-radius: 20; -fx-font-size: 12px;
                                              -fx-font-weight: bold; -fx-padding: 4 12;"/>
                                <Label fx:id="medecinLabel" text=""
                                       style="-fx-background-color: rgba(43,188,176,0.12); -fx-text-fill: #2BBCB0;
                                              -fx-background-radius: 20; -fx-font-size: 12px;
                                              -fx-font-weight: bold; -fx-padding: 4 12;"
                                       visible="false" managed="false"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="dateLabel"  text="" styleClass="stat-label"/>
                                <Label text="|" style="-fx-text-fill: #D1C4E9;"/>
                                <Label fx:id="viewsLabel" text="" styleClass="stat-label"/>
                                <Label fx:id="tagsLabel"  text="" styleClass="stat-label"
                                       visible="false" managed="false"/>
                            </HBox>

                            <!-- Carte contenu -->
                            <VBox style="-fx-background-color: white;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-padding: 26;">
                                <VBox fx:id="contenuContainer" spacing="6" minHeight="80"/>
                            </VBox>

                            <!-- Barre like + export -->
                            <HBox spacing="12" alignment="CENTER_LEFT"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 12;
                                         -fx-border-width: 1;
                                         -fx-padding: 12 18;">
                                <Button fx:id="likeBtn" text="❤  J'aime" onAction="#handleLike"
                                        styleClass="btn-outline" prefHeight="38" minWidth="130"
                                        style="-fx-padding: 0 20; -fx-font-size: 13px;"/>
                                <Label fx:id="likesLabel" text="0 likes" styleClass="stat-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="📄  Exporter PDF" onAction="#handleExportPdf"
                                        styleClass="btn-outline" prefHeight="38" minWidth="150"
                                        style="-fx-padding: 0 16; -fx-font-size: 13px;
                                               -fx-text-fill: #5B35A5; -fx-border-color: #D1C4E9;"/>
                            </HBox>

                            <!-- Évaluation article -->
                            <VBox fx:id="evalSection" spacing="10" visible="false" managed="false"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-padding: 18 22;">
                                <Label fx:id="evalTitre" text="⭐  Évaluez cet article"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3A1D7A;"/>
                                <Separator style="-fx-background-color: #EDE9F8;"/>
                                <HBox fx:id="evalStarsBox" spacing="6" alignment="CENTER_LEFT"/>
                                <Label fx:id="evalMessage" text="" wrapText="true"
                                       visible="false" managed="false"
                                       style="-fx-text-fill: #5B35A5; -fx-font-size: 12px; -fx-font-style: italic;"/>
                            </VBox>

                            <!-- Carte commentaires -->
                            <VBox spacing="14"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #EDE9F8;
                                         -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-padding: 22;">

                                <!-- Header commentaires + tri -->
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="commentHeaderLabel" text="💬 Commentaires"
                                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3A1D7A;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <ComboBox fx:id="sortComboBox" prefWidth="140"
                                              style="-fx-font-size:11px;-fx-background-color:#F8F6FF;-fx-border-color:#EDE9F8;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1;"/>
                                </HBox>
                                <Separator style="-fx-background-color: #EDE9F8;"/>

                                <VBox fx:id="commentsContainer" spacing="12" minHeight="40"/>

                                <!-- Zone de saisie commentaire -->
                                <VBox spacing="8"
                                      style="-fx-background-color:#F8F6FF;-fx-background-radius:12;-fx-border-color:#EDE9F8;-fx-border-radius:12;-fx-border-width:1;-fx-padding:12;">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label text="✏️" style="-fx-font-size:13px;"/>
                                        <Label text="Laisser un commentaire"
                                               style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#4A2D8F;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="emojiBtn" text="😊" onAction="#handleEmojiPicker"
                                                style="-fx-background-color:#EDE9F8;-fx-text-fill:#5B35A5;-fx-background-radius:8;-fx-border-width:0;-fx-padding:4 10;-fx-font-size:14px;-fx-cursor:hand;"/>
                                    </HBox>
                                    <TextArea fx:id="commentField" promptText="Partagez votre avis ou posez une question..."
                                              styleClass="field-input"
                                              prefHeight="80" wrapText="true"/>
                                    <HBox alignment="CENTER_RIGHT" spacing="10">
                                        <Label fx:id="charCountLabel" text="0 / 500"
                                               style="-fx-font-size:10px;-fx-text-fill:#9CA3AF;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="Envoyer →" onAction="#handleAddComment"
                                                style="-fx-background-color:#4A2D8F;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:8 20;-fx-cursor:hand;-fx-font-size:12px;"/>
                                    </HBox>
                                </VBox>
                            </VBox>

                        </VBox>
                    </VBox>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
