<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="root-pane bg-articles" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.PatientArticleListController">

    <!-- ── Sidebar patient ── -->
    <left>
        <VBox spacing="15.0" styleClass="form-panel" prefWidth="260.0">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="30.0"/></padding>
            <VBox alignment="CENTER" spacing="12.0">
                <StackPane>
                    <Circle radius="50.0" fill="#2BBCB0" opacity="0.1"/>
                    <Label text="👤" style="-fx-font-size: 40px;"/>
                </StackPane>
                <Label fx:id="patientNameLabel" text="Patient" styleClass="brand-title"/>
                <Label text="Patient" styleClass="stat-badge-info"/>
            </VBox>
            <Separator><VBox.margin><Insets top="10.0" bottom="10.0"/></VBox.margin></Separator>
            <VBox spacing="8.0">
                <Button text="🏠 Ma Santé"    onAction="#handleDashboard" styleClass="btn-secondary" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="📰 Articles"    styleClass="btn-primary"   maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="📅 Rendez-vous" styleClass="btn-secondary" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="💊 Traitements" styleClass="btn-secondary" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="⚙️ Paramètres"  styleClass="btn-secondary" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Déconnexion" onAction="#handleLogout" styleClass="btn-outline" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- ── Centre : grille OU détail ── -->
    <center>
        <StackPane>

            <!-- ══ VUE GRILLE ══ -->
            <VBox fx:id="gridView" spacing="0">

                <!-- Barre du haut -->
                <HBox spacing="16" styleClass="topbar" alignment="CENTER_LEFT">
                    <padding><Insets bottom="12" left="20" right="20" top="12"/></padding>
                    <Label text="📰 Articles Médicaux" styleClass="brand-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchField" promptText="🔍 Rechercher un article..."
                               styleClass="field-input" prefWidth="270"/>
                </HBox>

                <!-- Grille scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <FlowPane fx:id="articleFlowPane" hgap="16" vgap="16"
                              style="-fx-background-color: transparent;">
                        <padding><Insets bottom="24" left="20" right="20" top="20"/></padding>
                    </FlowPane>
                </ScrollPane>
            </VBox>

            <!-- ══ VUE DÉTAIL ══ -->
            <VBox fx:id="detailView" spacing="0" visible="false" managed="false">

                <!-- Barre du haut avec retour -->
                <HBox spacing="14" styleClass="topbar" alignment="CENTER_LEFT">
                    <padding><Insets bottom="12" left="20" right="20" top="12"/></padding>
                    <Button text="← Retour" onAction="#handleBack"
                            styleClass="btn-outline" prefWidth="95" prefHeight="34"/>
                    <Label fx:id="articleTitreLabel" text="" styleClass="brand-title"
                           wrapText="true" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statutBadge" text="Publié" styleClass="stat-badge-success"/>
                </HBox>

                <!-- Contenu scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox spacing="14">
                        <padding><Insets bottom="30" left="30" right="30" top="20"/></padding>

                        <!-- Métadonnées -->
                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <Label fx:id="dateLabel"   text="" styleClass="stat-label"/>
                            <Label fx:id="organeLabel" text="" styleClass="stat-label"/>
                            <Label fx:id="viewsLabel"  text="" styleClass="stat-label"/>
                        </HBox>

                        <!-- Tags -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label fx:id="tagsLabel" text="" styleClass="stat-label"
                                   visible="false" managed="false"/>
                        </HBox>

                        <Separator/>

                        <!-- Contenu article (rendu Markdown) -->
                        <VBox fx:id="contenuContainer" spacing="5" minHeight="80"
                              style="-fx-background-color: #F8F4FF; -fx-background-radius: 8;
                                     -fx-border-color: #D6CBFF; -fx-border-radius: 8;
                                     -fx-border-width: 1; -fx-padding: 14;"/>

                        <Separator/>

                        <!-- Like -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button fx:id="likeBtn" text="❤  J'aime" onAction="#handleLike"
                                    styleClass="btn-outline" prefHeight="40" minWidth="130"
                                    style="-fx-padding: 0 20;"/>
                            <Label fx:id="likesLabel" text="0 likes" styleClass="stat-label"/>
                        </HBox>

                        <Separator/>

                        <!-- Commentaires -->
                        <Label text="Commentaires" styleClass="section-title"/>
                        <VBox fx:id="commentsContainer" spacing="10" minHeight="80"/>

                        <HBox spacing="12" alignment="CENTER">
                            <TextArea fx:id="commentField" promptText="Votre commentaire..."
                                      styleClass="field-input" HBox.hgrow="ALWAYS"
                                      prefHeight="70" wrapText="true"/>
                            <Button text="Commenter" onAction="#handleAddComment"
                                    styleClass="btn-primary" prefWidth="120" prefHeight="70"/>
                        </HBox>

                    </VBox>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
