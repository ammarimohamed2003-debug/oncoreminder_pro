<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oncoreminder.controllers.ReservationController"
            stylesheets="@../css/style.css"
            styleClass="event-root">

    <!-- ══════════════ SIDEBAR (identique au dashboard médecin) ══════════════ -->
    <left>
        <VBox prefWidth="255" styleClass="doctor-sidebar">

            <!-- Branding -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-padding: 18 18 15 18;
                         -fx-border-color: transparent transparent rgba(255,255,255,0.10) transparent;
                         -fx-border-width: 0 0 1 0;">
                <StackPane>
                    <Circle radius="17" fill="rgba(43,188,176,0.15)"/>
                    <Circle radius="17" fill="transparent" stroke="#2BBCB0" strokeWidth="1.5"/>
                    <Rectangle width="5" height="16" fill="white" arcWidth="4" arcHeight="4"/>
                    <Rectangle width="16" height="5" fill="white" arcWidth="4" arcHeight="4"/>
                    <Circle radius="2.5" fill="#2BBCB0"/>
                </StackPane>
                <VBox spacing="2">
                    <HBox spacing="0">
                        <Label text="Onco"     style="-fx-text-fill: white;   -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Reminder" style="-fx-text-fill: #2BBCB0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="PRO"
                           style="-fx-background-color: rgba(43,188,176,0.25); -fx-text-fill: #2BBCB0;
                                  -fx-background-radius: 4; -fx-padding: 1 6; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Navigation -->
            <VBox spacing="2" style="-fx-padding: 10 10 0 10;">
                <Label text="NAVIGATION"
                       style="-fx-text-fill: rgba(255,255,255,0.32); -fx-font-size: 10px;
                              -fx-font-weight: bold; -fx-padding: 0 8 5 8;"/>
                <Button text="🏠  Mon Espace"    onAction="#handleDashboard"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button text="📰  Mes Articles"   onAction="#handleArticles"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn"/>
                <Button text="📅  Événements"
                        maxWidth="Infinity" styleClass="sidebar-nav-btn-doctor-active"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Pane prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.10);">
                <VBox.margin><Insets left="18" right="18" top="6"/></VBox.margin>
            </Pane>

            <VBox style="-fx-padding: 8 10 18 10;">
                <Button text="🔓  Déconnexion" onAction="#handleLogout"
                        maxWidth="Infinity" styleClass="sidebar-logout-btn"/>
            </VBox>
        </VBox>
    </left>

    <!-- ══════════════ TOP BAR ══════════════ -->
    <top>
        <HBox style="-fx-background-color:#FFFFFF; -fx-padding:10 20 10 20;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.10),10,0,0,3);"
              spacing="12" alignment="CENTER_LEFT">
            <Label text="Gestion des Réservations"
                   style="-fx-text-fill:#4A2D8F; -fx-font-size:14px; -fx-font-weight:bold;"/>
        </HBox>
    </top>

    <!-- ══════════════ MAIN CONTENT ══════════════ -->
    <center>
        <HBox spacing="16" style="-fx-padding:16; -fx-background-color:#EBF4FF;">

            <!-- ── LEFT : Form panel ── -->
            <VBox spacing="0" prefWidth="320" minWidth="290" styleClass="form-panel">

                <!-- Panel header -->
                <VBox style="-fx-background-color:linear-gradient(to right,#5B35A5,#4372C4);
                             -fx-background-radius:12 12 0 0; -fx-padding:14 18 14 18;">
                    <Label text="🎟  Nouvelle Réservation"
                           style="-fx-text-fill:#FFFFFF; -fx-font-size:15px; -fx-font-weight:bold;"/>
                    <Label text="Réserver une place pour l'utilisateur connecté"
                           style="-fx-text-fill:rgba(255,255,255,0.70); -fx-font-size:11px;"/>
                </VBox>

                <!-- Form body -->
                <VBox spacing="12" style="-fx-padding:18;">

                    <Label text="Événement *" styleClass="field-label"/>
                    <ComboBox fx:id="cbEvent" styleClass="field-combo"
                              maxWidth="Infinity"
                              promptText="Sélectionnez un événement…"/>

                    <Button text="✔  Confirmer la réservation" onAction="#reserverPlace"
                            maxWidth="Infinity"
                            style="-fx-background-color:#0D9488; -fx-text-fill:#FFFFFF;
                                   -fx-font-weight:bold; -fx-font-size:13px;
                                   -fx-background-radius:10; -fx-border-radius:10;
                                   -fx-padding:12 0 12 0; -fx-cursor:hand;
                                   -fx-effect:dropshadow(gaussian,rgba(13,148,136,0.40),10,0,0,4);"/>

                    <Separator style="-fx-padding:4 0 4 0;"/>

                    <!-- Cancel section -->
                    <VBox spacing="8"
                          style="-fx-background-color:#FFF5F5; -fx-background-radius:10;
                                 -fx-border-color:#FED7D7; -fx-border-radius:10;
                                 -fx-border-width:1.2; -fx-padding:14;">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="⚠" style="-fx-font-size:14px; -fx-text-fill:#C53030;"/>
                            <Label text="Annuler une réservation"
                                   style="-fx-text-fill:#C53030; -fx-font-size:13px; -fx-font-weight:bold;"/>
                        </HBox>
                        <Label text="Sélectionnez une ligne dans le tableau puis cliquez sur le bouton."
                               style="-fx-text-fill:#718096; -fx-font-size:11px;" wrapText="true"/>
                        <Button text="✖  Annuler la réservation sélectionnée"
                                onAction="#annulerReservation"
                                maxWidth="Infinity"
                                style="-fx-background-color:#FC8181; -fx-text-fill:#FFFFFF;
                                       -fx-font-weight:bold; -fx-font-size:12px;
                                       -fx-background-radius:8; -fx-border-radius:8;
                                       -fx-padding:10 0 10 0; -fx-cursor:hand;"/>
                    </VBox>

                    <!-- Feedback -->
                    <Label fx:id="lbMessage" wrapText="true"
                           style="-fx-text-fill:#2BBCB0; -fx-font-size:12px;
                                  -fx-font-weight:bold; -fx-padding:4 0 0 0;"/>
                </VBox>
            </VBox>

            <!-- ── RIGHT : Table panel ── -->
            <VBox spacing="0" HBox.hgrow="ALWAYS" styleClass="form-panel">

                <!-- Table header -->
                <HBox style="-fx-background-color:linear-gradient(to right,#5B35A5,#4372C4);
                             -fx-background-radius:12 12 0 0; -fx-padding:12 18 12 18;"
                      alignment="CENTER_LEFT" spacing="10">
                    <Label text="📋  Liste des Réservations"
                           style="-fx-text-fill:#FFFFFF; -fx-font-size:14px; -fx-font-weight:bold;"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Label text="Cliquez sur une ligne pour la sélectionner"
                           style="-fx-text-fill:rgba(255,255,255,0.65); -fx-font-size:11px;"/>
                </HBox>

                <!-- Table -->
                <TableView fx:id="tableReservation" VBox.vgrow="ALWAYS"
                           styleClass="main-table"
                           style="-fx-background-radius:0 0 12 12;">
                    <columns>
                        <TableColumn fx:id="colId"      text="ID Résa"      prefWidth="90"/>
                        <TableColumn fx:id="colEventId" text="ID Événement"  prefWidth="130"/>
                        <TableColumn fx:id="colUserId"  text="ID Patient"    prefWidth="120"/>
                        <TableColumn fx:id="colStatut"  text="Statut"        prefWidth="160"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="12" style="-fx-padding:50;">
                            <Label text="🎟" style="-fx-font-size:48px; -fx-text-fill:#C8DCF0;"/>
                            <Label text="Aucune réservation enregistrée"
                                   style="-fx-text-fill:#B0C4D8; -fx-font-size:14px; -fx-font-style:italic;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

        </HBox>
    </center>

    <!-- ══════════════ FOOTER ══════════════ -->
    <bottom>
        <HBox style="-fx-background-color:#FFFFFF; -fx-padding:9 20 9 20;
                     -fx-border-color:#C8DCF0; -fx-border-width:1 0 0 0;"
              alignment="CENTER_LEFT" spacing="8">
            <Label text="≋" style="-fx-text-fill:#5B35A5; -fx-font-size:13px;"/>
            <Label text="OncoReminder Pro v2.0  —  Module Réservations"
                   style="-fx-text-fill:#2BBCB0; -fx-font-size:11px;"/>
        </HBox>
    </bottom>

</BorderPane>